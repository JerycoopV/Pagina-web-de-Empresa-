---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = "Tu dinero al instante - Recreación" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts: Outfit -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Componente Header Flotante -->
		<Header />
		
		<!-- Contenedor Principal de la Página -->
		<main>
			<slot />
		</main>
		
		<!-- Componente Footer -->
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		--bg-dark: #000000;
		--bg-card: #0c0c0e;
		--border-color: rgba(255, 255, 255, 0.08);
		
		/* Paleta de Colores de Referencia */
		--color-purple: #7c3aed;
		--color-purple-hover: #8b5cf6;
		--color-orange: #ea580c;
		--color-orange-hover: #f97316;
		
		/* Gradientes Premium */
		--gradient-accent: linear-gradient(135deg, #7c3aed 0%, #ea580c 100%);
		--gradient-button: linear-gradient(90deg, #7c3aed 0%, #ea580c 100%);
		--gradient-button-hover: linear-gradient(90deg, #8b5cf6 0%, #f97316 100%);
	}

	/* Reseteo y Estilos Base */
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		font-family: var(--font-sans);
		background-color: var(--bg-dark);
		color: #ffffff;
		min-height: 100vh;
		overflow-x: hidden;
		line-height: 1.5;
	}

	/* Contenedor Principal */
	main {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px;
		margin-top: 120px; /* Margen para evitar que el header flotante tape el contenido */
		position: relative;
		z-index: 1;
	}

	/* Efecto de Luces Ambientales de Fondo (Mesh Gradients) */
	body::before {
		content: '';
		position: fixed;
		top: -10%;
		right: -10%;
		width: 60vw;
		height: 60vw;
		background: radial-gradient(circle, rgba(124, 58, 237, 0.07) 0%, transparent 60%);
		z-index: -1;
		pointer-events: none;
		filter: blur(100px);
	}

	body::after {
		content: '';
		position: fixed;
		bottom: -10%;
		left: -10%;
		width: 50vw;
		height: 50vw;
		background: radial-gradient(circle, rgba(234, 88, 12, 0.05) 0%, transparent 60%);
		z-index: -1;
		pointer-events: none;
		filter: blur(100px);
	}

	/* Estilos de scrollbar premium */
	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: #020202;
	}

	::-webkit-scrollbar-thumb {
		background: #1a1a1a;
		border-radius: 5px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #252525;
	}
</style>
