---
import logo from '../assets/logo.svg';

interface Props {
  // Add optional props here if needed
}

const pathname = Astro.url.pathname;
// Normalize pathname to prevent trailing slash mismatches
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Beneficios', href: '/beneficios' },
  { name: 'Ayuda', href: '/ayuda' },
  { name: 'Legal', href: '/legal' }
];
---

<header class="header-container">
  <nav class="navbar" id="main-navbar">
    <!-- Logotipo Premium -->
    <a href="/" class="logo-link" aria-label="Ir a Inicio" id="nav-logo">
      <div class="logo-wrapper">
        <img src={logo.src} alt="Capital Fest Logo" class="logo-svg" />
      </div>
    </a>

    <!-- Enlaces de Navegación -->
    <ul class="nav-links">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li>
            <a 
              href={item.href} 
              class={`nav-link ${isActive ? 'active' : ''}`}
              id={`nav-link-${item.name.toLowerCase()}`}
            >
              {item.name}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Botones de Acción (Desktop) -->
    <div class="actions">
      <a href="/login" class="btn btn-outline" id="btn-ingresar">Ingresar</a>
      <a href="/register" class="btn btn-gradient" id="btn-crear-cuenta">Crear Cuenta</a>
    </div>

    <!-- Botón de Menú Móvil (Hamburger) -->
    <button class="mobile-menu-btn" aria-label="Abrir menú de navegación" id="mobile-menu-toggle">
      <svg class="menu-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="6" x2="20" y2="6" class="line-1"></line>
        <line x1="4" y1="12" x2="20" y2="12" class="line-2"></line>
        <line x1="4" y1="18" x2="20" y2="18" class="line-3"></line>
      </svg>
    </button>
  </nav>

  <!-- Menú Móvil Desplegable Premium -->
  <div class="mobile-menu-dropdown" id="mobile-menu">
    <ul class="mobile-nav-links">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li>
            <a 
              href={item.href} 
              class={`mobile-nav-link ${isActive ? 'active' : ''}`}
            >
              {item.name}
            </a>
          </li>
        );
      })}
    </ul>
    <div class="mobile-actions">
      <a href="/login" class="btn btn-outline mobile-btn" id="mobile-btn-ingresar">Ingresar</a>
      <a href="/register" class="btn btn-gradient mobile-btn" id="mobile-btn-crear-cuenta">Crear Cuenta</a>
    </div>
  </div>
</header>

<style is:global>
  /* Contenedor del Header flotante */
  .header-container {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1100px;
    z-index: 1000;
    position: fixed;
  }

  /* Barra de Navegación Estilo Cápsula de Cristal */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
    padding: 10px 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 1002;
  }

  /* Efecto hover general de la barra */
  .navbar:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(12, 12, 12, 0.75);
    box-shadow: 0 20px 50px rgba(124, 58, 237, 0.1), 0 20px 40px rgba(0, 0, 0, 0.8);
  }

  /* Enlace del logo */
  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .logo-wrapper:hover {
    transform: scale(1.05);
  }

  .logo-svg {
    height: 38px;
    width: auto;
  }

  /* Lista de Enlaces */
  .nav-links {
    display: flex;
    list-style: none;
    gap: 32px;
    align-items: center;
  }

  /* Enlaces individuales */
  .nav-link {
    color: rgba(255, 255, 255, 0.6);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 8px 4px;
    position: relative;
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  /* Enlace activo */
  .nav-link.active {
    color: #ffffff;
    font-weight: 600;
  }

  /* Subrayado animado para el link activo */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--gradient-accent, linear-gradient(90deg, #7c3aed, #ea580c));
    border-radius: 2px;
    transform: translateX(-50%);
    transition: width 0.3s ease;
  }

  .nav-link.active::after {
    width: 100%;
  }

  .nav-link:hover::after {
    width: 60%;
  }

  /* Botones de acción */
  .actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Botón Ingresar */
  .btn-outline {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  /* Botón Crear Cuenta */
  .btn-gradient {
    color: #ffffff;
    background: linear-gradient(90deg, #7c3aed 0%, #ea580c 100%);
    border: none;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.2);
  }

  .btn-gradient:hover {
    background: linear-gradient(90deg, #8b5cf6 0%, #f97316 100%);
    box-shadow: 0 6px 20px rgba(234, 88, 12, 0.3);
    transform: translateY(-1px);
  }

  /* --- MENU MOVIL (HAMBURGER) --- */
  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 6px;
    z-index: 1003;
    outline: none;
  }

  .menu-icon {
    width: 24px;
    height: 24px;
  }

  .menu-icon line {
    transition: transform 0.3s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  /* Efecto animación de X al abrir */
  .mobile-menu-btn.open .line-1 {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .mobile-menu-btn.open .line-2 {
    opacity: 0;
  }
  .mobile-menu-btn.open .line-3 {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Dropdown móvil con glassmorphism premium */
  .mobile-menu-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px;
    padding: 24px;
    margin-top: 10px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), 0 0 30px rgba(124, 58, 237, 0.05);
    flex-direction: column;
    gap: 24px;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 1001;
  }

  .mobile-menu-dropdown.open {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-link {
    display: block;
    color: rgba(255, 255, 255, 0.6);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    padding: 12px 16px;
    border-radius: 14px;
    transition: all 0.3s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 20px;
  }

  .mobile-btn {
    width: 100%;
    text-align: center;
    padding: 12px;
  }

  /* Responsivo para móviles */
  @media (max-width: 768px) {
    .header-container {
      width: 95%;
      top: 16px;
    }
    
    .navbar {
      padding: 8px 16px 8px 20px;
      border-radius: 30px;
    }

    .nav-links,
    .navbar > .actions {
      display: none; /* Oculta enlaces de desktop y botones principales */
    }

    .mobile-menu-btn {
      display: block; /* Muestra el botón de hamburguesa */
    }

    .logo-svg {
      height: 32px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = toggleBtn.classList.toggle('open');
      mobileMenu.classList.toggle('open', isOpen);
    });

    // Cierra el menú al hacer click en cualquier link
    const links = mobileMenu.querySelectorAll('.mobile-nav-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.classList.remove('open');
        mobileMenu.classList.remove('open');
      });
    });
  }
</script>
