---
// Componente Footer Modular para Capital Fest
import '../styles/footer.css';
---

<footer class="footer">
  <div class="footer-container">
    <!-- Fila Superior: 4 Columnas -->
    <div class="footer-grid">
      <!-- Columna 1: Marca y Redes -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand" id="footer-brand-logo">
          <div class="logo-wrapper">
            <svg class="logo-svg" viewBox="0 0 50 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="footer-logo-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#4f46e5" /> <!-- Indigo/Blue -->
                  <stop offset="50%" stop-color="#a855f7" /> <!-- Purple -->
                  <stop offset="100%" stop-color="#ea580c" /> <!-- Orange -->
                </linearGradient>
              </defs>
              <path 
                d="M16 10C16 10 25 5 35 11C37.5 12.5 38.5 15.5 36.5 17.5C34.5 19.5 31.5 18.5 29.5 17.5C23.5 14.5 19 16.5 19 21.5C19 26.5 23.5 28.5 29.5 25.5C31.5 24.5 34.5 23.5 36.5 25.5C38.5 27.5 37.5 30.5 35 32C25 38 16 33 16 33" 
                stroke="url(#footer-logo-gradient)" 
                stroke-width="5" 
                stroke-linecap="round"
              />
              <path 
                d="M26 21.5H39" 
                stroke="url(#footer-logo-gradient)" 
                stroke-width="5" 
                stroke-linecap="round"
              />
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-title">Capital</span>
            <span class="brand-subtitle">Fest</span>
          </div>
        </a>
        <p class="brand-description">
          Accede a efectivo de forma<br />
          rápida, simple y segura.<br />
          Tu dinero cuando más<br />
          lo necesitas.
        </p>
        
        <div class="social-section">
          <span class="social-title">Síguenos</span>
          <div class="social-icons">
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Síguenos en Instagram" id="social-instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Síguenos en TikTok" id="social-tiktok">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
              </svg>
            </a>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Síguenos en Facebook" id="social-facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="footer-col links-col">
        <h4 class="col-title">NAVEGACIÓN</h4>
        <ul class="col-links">
          <li><a href="/" id="footer-link-inicio">Inicio</a></li>
          <li><a href="/nosotros" id="footer-link-nosotros">Nosotros</a></li>
          <li><a href="/beneficios" id="footer-link-beneficios">Beneficios</a></li>
          <li><a href="/ayuda" id="footer-link-ayuda">Ayuda</a></li>
          <li><a href="/legal" id="footer-link-legal">Legal</a></li>
        </ul>
      </div>

      <!-- Columna 3: Legal -->
      <div class="footer-col links-col">
        <h4 class="col-title">LEGAL</h4>
        <ul class="col-links">
          <li><a href="/legal#terminos" id="footer-link-terminos">Terminos y condiciones</a></li>
          <li><a href="/legal#privacidad" id="footer-link-privacidad">Política de privacidad</a></li>
          <li><a href="/legal#cookies" id="footer-link-cookies">Política de cookies</a></li>
          <li><a href="/legal#seguridad" id="footer-link-seguridad">Seguridad de datos</a></li>
        </ul>
      </div>

      <!-- Columna 4: Contacto -->
      <div class="footer-col contact-col">
        <h4 class="col-title">CONTACTO</h4>
        <div class="contact-items">
          <!-- WhatsApp -->
          <a href="https://wa.me/51900000000" target="_blank" rel="noopener noreferrer" class="contact-item" id="footer-contact-whatsapp">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <div class="contact-text">
              <span class="contact-label">WhatsApp</span>
              <span class="contact-sub">Atención inmediata</span>
            </div>
          </a>

          <!-- Email -->
          <a href="mailto:Festcorporation.peru@gmail.com" class="contact-item" id="footer-contact-email">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="contact-text">
              <span class="contact-label email-label">Festcorporation.peru@gmail.com</span>
              <span class="contact-sub">Escribenos</span>
            </div>
          </a>

          <!-- Dirección -->
          <div class="contact-item" id="footer-contact-address">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="contact-text">
              <span class="contact-label">Lima, Perú</span>
              <span class="contact-sub">Atención a nivel Nacional</span>
            </div>
          </div>

          <!-- Horario -->
          <div class="contact-item" id="footer-contact-hours">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="contact-text">
              <span class="contact-label">Lunes a Sábado</span>
              <span class="contact-sub">8:00 a.m. - 18:00 p.m.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Fila Inferior: Créditos -->
    <div class="footer-bottom">
      <div class="bottom-item copyright-item">
        <span>© 2026 <a href="/" class="copyright-link">Capital Fest</a></span>
        <span>Todos los derechos reservados.</span>
      </div>
      
      <div class="bottom-item text-item">
        <span>Tu información está protegida, con los estándares</span>
        <span>de seguridad adecuados para su tranquilidad.</span>
      </div>

      <div class="bottom-item text-item">
        <span>Diseñado para una experiencia</span>
        <span>rápida, segura y sin complicaciones.</span>
      </div>

      <div class="bottom-item designer-item">
        <span>Designed by</span>
        <span class="designer-name">K2B Studios</span>
      </div>
    </div>
  </div>
</footer>


