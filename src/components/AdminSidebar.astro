---
interface Props {
  active?: 'home' | 'inicio' | 'dashboard' | 'resumen' | 'validations' | 'validaciones' | 'users' | 'usuarios' | 'cards' | 'tarjetas' | string;
}

const { active = 'home' } = Astro.props;
const isHome = active === 'home' || active === 'inicio';
const isResumen = active === 'dashboard' || active === 'resumen';
const isValidations = active === 'validations' || active === 'validaciones';
const isUsers = active === 'users' || active === 'usuarios';
const isCards = active === 'cards' || active === 'tarjetas';
---

<aside class="dash-sidebar" id="dash-sidebar">
  <div class="sidebar-top">
    <!-- Logo Principal -->
    <a href="/admin" class="sidebar-logo">
      <img src="/assets/logo.svg" alt="Capital Fest Logo" class="sidebar-logo-img" />
    </a>

    <!-- Lista de Enlaces de Navegación -->
    <nav aria-label="Navegación de administración">
      <ul class="sidebar-nav">
        <li class="nav-section-title">Dashboard</li>
        
        <li>
          <a href="/admin" class:list={['nav-item', { active: isHome }]}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
            <span>Inicio</span>
          </a>
        </li>

        <li>
          <a href="/admin/resumen" class:list={['nav-item', { active: isResumen }]}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8"></polygon>
            </svg>
            <span>Resumen</span>
          </a>
        </li>

        <li>
          <a href="/admin/validaciones" class:list={['nav-item', { active: isValidations }]}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Validaciones KYC</span>
          </a>
        </li>

        <li>
          <a href="/admin/usuarios" class:list={['nav-item', { active: isUsers }]}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
            <span>Usuarios</span>
          </a>
        </li>

        <li>
          <a href="/admin/tarjetas" class:list={['nav-item', { active: isCards }]}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span>Tarjetas</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Tarjeta de Información de Seguridad -->
    <div class="sidebar-security-card">
      <div class="security-header">
        <div class="security-icon-box">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <span class="security-title">Tu seguridad es nuestra prioridad</span>
      </div>
      <p class="security-desc">Sistema 100% seguro y encriptado.</p>
      <button class="security-btn-pill" type="button" aria-label="Más información">
        <span>Más información</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Pie del Sidebar: Usuario y Cierre de Sesión -->
  <div class="sidebar-bottom">
    <div class="sidebar-user-row" id="sidebar-admin-row">
      <div class="user-avatar" id="sidebar-admin-avatar">A</div>
      <div class="user-info">
        <span class="user-name" id="sidebar-admin-name">Admin C.</span>
        <span class="user-link">Ver perfil <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
      </div>
    </div>

    <button class="sidebar-logout-btn" id="sidebar-admin-logout" type="button">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      <span>Cerrar sesión</span>
    </button>
  </div>
</aside>

<script>
  try {
    const rawUser = localStorage.getItem('capitalFest_user');
    if (rawUser) {
      const user = JSON.parse(rawUser);
      const sidebarAvatar = document.getElementById('sidebar-admin-avatar');
      const sidebarName = document.getElementById('sidebar-admin-name');
      if (user.firstName) {
        if (sidebarAvatar) sidebarAvatar.textContent = user.firstName[0].toUpperCase();
        if (sidebarName) {
          const lastInitial = user.lastName ? ` ${user.lastName[0].toUpperCase()}.` : '';
          sidebarName.textContent = `${user.firstName}${lastInitial}`;
        }
      }
    }
  } catch (e) {}

  const logoutBtn = document.getElementById('sidebar-admin-logout');
  logoutBtn?.addEventListener('click', async () => {
    try {
      const token = localStorage.getItem('capitalFest_token');
      const apiRoot = (import.meta.env.PUBLIC_API_URL || '').replace(/\/$/, '');
      const api = apiRoot.endsWith('/api') ? apiRoot : `${apiRoot}/api`;
      if (token && apiRoot) {
        await fetch(`${api}/auth/logout`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` }
        });
      }
    } catch (e) {}
    localStorage.removeItem('capitalFest_token');
    localStorage.removeItem('capitalFest_user');
    window.location.href = '/login';
  });

  const sidebar = document.getElementById('dash-sidebar');
  const toggleBtn = document.getElementById('mobile-sidebar-btn');
  const backdrop = document.getElementById('sidebar-backdrop');
  toggleBtn?.addEventListener('click', () => {
    sidebar?.classList.toggle('open');
  });
  backdrop?.addEventListener('click', () => {
    sidebar?.classList.remove('open');
  });
</script>
