<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Cargar nombre de usuario desde localStorage
    const savedUser = localStorage.getItem('capitalFest_user');
    if (savedUser) {
      try {
        const parsed = JSON.parse(savedUser);
        const name = parsed.firstName || 'Joshua';
        const initial = name.charAt(0).toUpperCase();
        
        const sideAvatar = document.getElementById('sidebar-avatar-initial');
        const headAvatar = document.getElementById('header-avatar-initial');
        const sideName = document.getElementById('sidebar-user-fullname');
        
        if (sideAvatar) sideAvatar.textContent = initial;
        if (headAvatar) headAvatar.textContent = initial;
        if (sideName) sideName.innerHTML = `${name} V. <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>`;
      } catch (e) {}
    }

    // 2. Toggle del Sidebar en Pantallas Pequeñas con Backdrop
    const mobileBtn = document.getElementById('mobile-sidebar-btn');
    const sidebar = document.getElementById('dash-sidebar');
    const sidebarBackdrop = document.getElementById('sidebar-backdrop');

    function toggleSidebar(open?: boolean) {
      if (!sidebar) return;
      const willOpen = open !== undefined ? open : !sidebar.classList.contains('open');
      sidebar.classList.toggle('open', willOpen);
      sidebarBackdrop?.classList.toggle('active', willOpen);
    }

    if (mobileBtn) {
      mobileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSidebar();
      });
    }

    if (sidebarBackdrop) {
      sidebarBackdrop.addEventListener('click', () => toggleSidebar(false));
    }

    // 3. Cierre de Sesión
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        if (confirm('¿Estás seguro de que deseas cerrar sesión?')) {
          localStorage.removeItem('capitalFest_user');
          window.location.href = '/login';
        }
      });
    }

    // 4. Selección de Tarjetas e Interacción Dinámica
    const cardBoxes = document.querySelectorAll('.card-item-box');
    const panelCardPreview = document.getElementById('panel-card-preview');
    const panelBankBrand = document.getElementById('panel-bank-brand');
    const panelNetworkLogo = document.getElementById('panel-network-logo');
    const panelFullNumber = document.getElementById('panel-full-number');
    const panelMaskedDigits = document.getElementById('panel-masked-digits');
    const panelHolderName = document.getElementById('panel-holder-name');
    const panelExpiryDate = document.getElementById('panel-expiry-date');

    const panelMetaBank = document.getElementById('panel-meta-bank');
    const panelMetaType = document.getElementById('panel-meta-type');
    const panelMetaHolder = document.getElementById('panel-meta-holder');
    const panelMetaNumber = document.getElementById('panel-meta-number');
    const panelMetaExpiry = document.getElementById('panel-meta-expiry');

    const panelLimitTotal = document.getElementById('panel-limit-total');
    const panelLimitUsed = document.getElementById('panel-limit-used');
    const panelLimitBar = document.getElementById('panel-limit-bar');
    const panelLimitAvail = document.getElementById('panel-limit-avail');

    function selectCard(box: HTMLElement) {
      cardBoxes.forEach(b => b.classList.remove('selected'));
      box.classList.add('selected');

      const bank = box.dataset.bank || 'Interbank';
      const type = box.dataset.cardType || 'Visa Débito';
      const fullNum = box.dataset.fullNumber || '1234 5678 9012 3456';
      const masked = box.dataset.masked || '•••• 3456';
      const holder = box.dataset.holder || 'Joshua Villanueva';
      const expiry = box.dataset.expiry || '12/28';
      const total = box.dataset.limitTotal || 'S/ 10,000.00';
      const used = box.dataset.limitUsed || 'S/ 1,500.00';
      const avail = box.dataset.limitAvail || 'S/ 8,500.00';
      const percent = box.dataset.percent || '15%';
      const theme = box.dataset.theme || 'interbank';

      // Actualizar preview de tarjeta
      if (panelFullNumber) panelFullNumber.textContent = fullNum;
      if (panelMaskedDigits) panelMaskedDigits.textContent = masked;
      if (panelHolderName) panelHolderName.textContent = holder.toUpperCase();
      if (panelExpiryDate) panelExpiryDate.textContent = expiry;

      if (panelBankBrand) {
        if (bank === 'Interbank') {
          panelBankBrand.innerHTML = '<span class="brand-sq-interbank"></span> <span>Interbank</span>';
        } else if (bank === 'BBVA') {
          panelBankBrand.innerHTML = '<span class="brand-txt-bbva">BBVA</span>';
        } else if (bank === 'BCP') {
          panelBankBrand.innerHTML = '<span class="brand-txt-bcp"><span>&gt;</span> BCP</span>';
        }
      }

      if (panelNetworkLogo) {
        if (type.includes('Mastercard')) {
          panelNetworkLogo.innerHTML = '<span class="mc-circles"><span class="mc-c1"></span><span class="mc-c2"></span></span>';
        } else {
          panelNetworkLogo.innerHTML = '<span class="card-network-logo visa">VISA</span>';
        }
      }

      if (panelCardPreview) {
        panelCardPreview.className = 'detail-card-preview';
        if (theme === 'interbank') panelCardPreview.style.background = 'linear-gradient(135deg, #0e1526 0%, #060914 100%)';
        else if (theme === 'bbva') panelCardPreview.style.background = 'linear-gradient(135deg, #0b1120 0%, #060913 100%)';
        else if (theme === 'bcp') panelCardPreview.style.background = 'linear-gradient(135deg, #130f20 0%, #07050e 100%)';
      }

      // Actualizar detalles del panel
      if (panelMetaBank) panelMetaBank.textContent = bank;
      if (panelMetaType) panelMetaType.textContent = type;
      if (panelMetaHolder) panelMetaHolder.textContent = holder;
      if (panelMetaNumber) panelMetaNumber.textContent = fullNum;
      if (panelMetaExpiry) panelMetaExpiry.textContent = expiry;

      // Límites
      if (panelLimitTotal) panelLimitTotal.textContent = total;
      if (panelLimitUsed) panelLimitUsed.textContent = used;
      if (panelLimitAvail) panelLimitAvail.textContent = avail;
      if (panelLimitBar) panelLimitBar.style.width = percent;
    }

    // 5. Abrir panel derecho de detalles al hacer click en "Ver detalles" o en la tarjeta
    const cardDetailPanel = document.querySelector('.card-detail-panel') as HTMLElement;

    function openCardDetails(box: HTMLElement) {
      selectCard(box);
      if (cardDetailPanel) {
        cardDetailPanel.classList.remove('pulse-highlight');
        void cardDetailPanel.offsetWidth; // trigger reflow
        cardDetailPanel.classList.add('pulse-highlight');

        if (window.innerWidth <= 1280) {
          cardDetailPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    }

    cardBoxes.forEach(box => {
      box.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.card-more-menu-wrapper')) return;
        openCardDetails(box as HTMLElement);
      });

      const detailsBtn = box.querySelector('.btn-card-details');
      if (detailsBtn) {
        detailsBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          openCardDetails(box as HTMLElement);
        });
      }
    });

    // 6. Menú de 3 puntos (•••) para Bloquear y Eliminar tarjeta
    const allMoreBtns = document.querySelectorAll('.btn-card-more, .btn-detail-more');
    allMoreBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const wrapper = (btn as HTMLElement).closest('.card-more-menu-wrapper');
        const menu = wrapper?.querySelector('.card-dropdown-menu');
        const isOpen = menu?.classList.contains('open');

        // Cerrar otros menús abiertos
        document.querySelectorAll('.card-dropdown-menu').forEach(m => m.classList.remove('open'));

        if (!isOpen && menu) {
          menu.classList.add('open');
        }
      });
    });

    // Cerrar menús al hacer click fuera
    document.addEventListener('click', () => {
      document.querySelectorAll('.card-dropdown-menu').forEach(m => m.classList.remove('open'));
    });

    // Función unificada para bloquear/desbloquear
    let isLocked = false;
    const lockBtn = document.getElementById('btn-lock-card');
    const lockText = document.getElementById('btn-lock-text');
    const statusText = document.getElementById('panel-status-text');

    function toggleCardLock(bank: string, specificCardBox?: HTMLElement) {
      isLocked = !isLocked;
      if (lockText) lockText.textContent = isLocked ? 'Desbloquear tarjeta' : 'Bloquear tarjeta';
      if (statusText) statusText.textContent = isLocked ? 'Bloqueada' : 'Activa';

      const panelPill = document.getElementById('panel-status-pill');
      if (panelPill) {
        if (isLocked) {
          panelPill.style.background = 'rgba(239, 68, 68, 0.15)';
          panelPill.style.color = '#ef4444';
          panelPill.style.borderColor = 'rgba(239, 68, 68, 0.3)';
        } else {
          panelPill.style.background = '';
          panelPill.style.color = '';
          panelPill.style.borderColor = '';
        }
      }

      document.querySelectorAll('.dropdown-lock-text, #panel-dropdown-lock-text').forEach(t => {
        t.textContent = isLocked ? 'Desbloquear tarjeta' : 'Bloquear tarjeta';
      });

      if (specificCardBox) {
        const dot = specificCardBox.querySelector('.card-status-dot') as HTMLElement;
        const text = specificCardBox.querySelector('.card-status-indicator span:last-child') as HTMLElement;
        if (dot && text) {
          if (isLocked) {
            dot.style.background = '#ef4444';
            dot.style.boxShadow = '0 0 6px #ef4444';
            text.style.color = '#ef4444';
            text.textContent = 'Bloqueada';
          } else {
            dot.style.background = '';
            dot.style.boxShadow = '';
            text.style.color = '';
            text.textContent = 'Activa';
          }
        }
      }

      alert(isLocked ? `La tarjeta ${bank} ha sido bloqueada temporalmente.` : `La tarjeta ${bank} ha sido desbloqueada con éxito.`);
    }

    // Acción de Bloquear desde el panel inferior
    if (lockBtn) {
      lockBtn.addEventListener('click', () => {
        const activeCard = document.querySelector('.card-item-box.selected') as HTMLElement;
        const bank = activeCard?.dataset.bank || 'seleccionada';
        toggleCardLock(bank, activeCard);
      });
    }

    // Acción de Bloquear desde los dropdowns de 3 puntos
    document.querySelectorAll('.dropdown-item.item-lock').forEach(item => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        document.querySelectorAll('.card-dropdown-menu').forEach(m => m.classList.remove('open'));
        const cardBox = (item as HTMLElement).closest('.card-item-box') as HTMLElement || document.querySelector('.card-item-box.selected') as HTMLElement;
        const bank = cardBox?.dataset.bank || 'seleccionada';
        toggleCardLock(bank, cardBox);
      });
    });

    // Acción de Eliminar Tarjeta (panel + dropdowns)
    function executeDeleteCard(bank: string) {
      if (confirm(`¿Estás seguro de que deseas desvincular ${bank} de tu cuenta?`)) {
        alert(`La tarjeta ${bank} ha sido desvinculada exitosamente.`);
      }
    }

    const deleteBtn = document.getElementById('btn-delete-card');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', () => {
        const activeCard = document.querySelector('.card-item-box.selected') as HTMLElement;
        const bank = activeCard?.dataset.bank || 'esta tarjeta';
        executeDeleteCard(bank);
      });
    }

    document.querySelectorAll('.dropdown-item.item-delete').forEach(item => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        document.querySelectorAll('.card-dropdown-menu').forEach(m => m.classList.remove('open'));
        const cardBox = (item as HTMLElement).closest('.card-item-box') as HTMLElement || document.querySelector('.card-item-box.selected') as HTMLElement;
        const bank = cardBox?.dataset.bank || 'esta tarjeta';
        executeDeleteCard(bank);
      });
    });

    // 6. Modal Vincular Nueva Tarjeta
    const openModalBtn = document.getElementById('btn-open-modal-link');
    const closeModalBtn = document.getElementById('modal-close-btn');
    const modal = document.getElementById('modal-new-card');
    const formNewCard = document.getElementById('form-new-card');

    if (openModalBtn && modal) {
      openModalBtn.addEventListener('click', () => modal.classList.add('open'));
    }
    if (closeModalBtn && modal) {
      closeModalBtn.addEventListener('click', () => modal.classList.remove('open'));
    }
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('open');
      });
    }
    if (formNewCard && modal) {
      formNewCard.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('¡Tarjeta vinculada exitosamente a tu cuenta!');
        modal.classList.remove('open');
      });
    }
  });
</script>
