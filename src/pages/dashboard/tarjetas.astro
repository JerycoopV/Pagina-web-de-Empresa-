---
import Layout from '../../layouts/Layout.astro';
import '../../styles/dashboard-tarjetas.css';
---

<Layout title="Mis Tarjetas | Capital Fest" hideHeaderFooter={true}>
  <div class="tarjetas-layout">
    
    <!-- Botón Toggle de Menú en Móviles -->
    <button class="mobile-sidebar-toggle" id="mobile-sidebar-btn" aria-label="Abrir menú de navegación">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- ==========================================
         1. BARRA LATERAL (SIDEBAR NAVIGATION)
         ========================================== -->
    <aside class="dash-sidebar" id="dash-sidebar">
      <div class="sidebar-top">
        <!-- Logo Principal -->
        <a href="/" class="sidebar-logo">
          <img src="/assets/logo.svg" alt="Capital Fest Logo" class="sidebar-logo-img" />
        </a>

        <!-- Lista de Enlaces de Navegación -->
        <nav>
          <ul class="sidebar-nav">
            <li class="nav-section-title">Dashboard</li>
            
            <li>
              <a href="/dashboard" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                  <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                </svg>
                <span>Dashboard</span>
              </a>
            </li>

            <li>
              <a href="/simulador" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <circle cx="12" cy="12" r="9"></circle>
                  <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
                </svg>
                <span>Nueva simulación</span>
              </a>
            </li>

            <li>
              <a href="/dashboard/historial" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Historial</span>
              </a>
            </li>

            <li>
              <a href="/dashboard/tarjetas" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span>Mis tarjetas</span>
              </a>
            </li>

            <li>
              <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <span>Estadísticas</span>
              </a>
            </li>

            <li>
              <a href="/beneficios" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Beneficios</span>
              </a>
            </li>

            <li>
              <a href="/ayuda" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Soporte</span>
              </a>
            </li>

            <li>
              <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                <span>Configuración</span>
              </a>
            </li>
          </ul>
        </nav>

        <!-- Tarjeta de Seguridad -->
        <div class="sidebar-security-card">
          <div class="security-header">
            <div class="security-icon-box">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <span class="security-title">Tu seguridad es nuestra prioridad</span>
          </div>
          <p class="security-desc">Sistema 100% seguro y encriptado.</p>
          <button class="security-btn-pill" aria-label="Más información">
            <span>Más información</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Pie del Sidebar: Usuario y Cierre de Sesión -->
      <div class="sidebar-bottom">
        <div class="sidebar-user-row" id="user-profile-row">
          <div class="user-avatar" id="sidebar-avatar-initial">J</div>
          <div class="user-info">
            <span class="user-name" id="sidebar-user-fullname">
              Joshua V.
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
            <span class="user-link">Ver perfil</span>
          </div>
        </div>

        <button class="sidebar-logout-btn" id="logout-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <!-- ==========================================
         2. CONTENIDO PRINCIPAL: MIS TARJETAS
         ========================================== -->
    <main class="tarjetas-content">
      
      <!-- TOP HEADER BAR -->
      <header class="tarjetas-top-bar">
        <div class="tarjetas-title-box">
          <h1 class="tarjetas-page-title">Mis tarjetas</h1>
          <p class="tarjetas-page-subtitle">Administra tus tarjetas vinculadas a Capital Fest.</p>
        </div>

        <div class="tarjetas-top-actions">
          <button class="notification-btn" aria-label="Notificaciones">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="notification-badge">3</span>
          </button>
          
          <div class="top-user-avatar" id="header-avatar-initial">J</div>

          <button class="btn-link-card" id="btn-open-modal-link">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Vincular nueva tarjeta</span>
          </button>
        </div>
      </header>

      <!-- TARJETAS DE MÉTRICAS (4 STAT CARDS) -->
      <section class="tarjetas-metrics-grid">
        <!-- 1. Tarjetas vinculadas -->
        <div class="metric-stat-card">
          <div class="metric-circle-icon purple">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
          </div>
          <div class="metric-stat-info">
            <span class="metric-stat-label">Tarjetas vinculadas</span>
            <span class="metric-stat-value">3</span>
            <span class="metric-stat-tag active-tag">Activas</span>
          </div>
        </div>

        <!-- 2. Tarjetas activas -->
        <div class="metric-stat-card">
          <div class="metric-circle-icon green">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <div class="metric-stat-info">
            <span class="metric-stat-label">Tarjetas activas</span>
            <span class="metric-stat-value">3</span>
            <span class="metric-stat-tag active-tag">100% del total</span>
          </div>
        </div>

        <!-- 3. Límite total disponible -->
        <div class="metric-stat-card">
          <div class="metric-circle-icon yellow">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="metric-stat-info">
            <span class="metric-stat-label">Límite total disponible</span>
            <span class="metric-stat-value">S/ 18,500.00</span>
            <span class="metric-stat-tag muted-tag">De S/ 22,000.00</span>
          </div>
        </div>

        <!-- 4. Última actividad -->
        <div class="metric-stat-card">
          <div class="metric-circle-icon purple">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="metric-stat-info">
            <span class="metric-stat-label">Última actividad</span>
            <span class="metric-stat-value" style="font-size: 1.25rem;">Hoy, 14:32</span>
            <span class="metric-stat-tag muted-tag">Simulación realizada</span>
          </div>
        </div>
      </section>

      <!-- ÁREA DE TRABAJO PRINCIPAL (IZQUIERDA: CAROUSEL + TRANSACCIONES, DERECHA: DETALLE) -->
      <section class="tarjetas-workspace">
        
        <div class="tarjetas-main-column">
          <!-- CABECERA DE LA SECCIÓN DE TARJETAS -->
          <div class="cards-section-header">
            <h2 class="cards-section-title">
              Mis tarjetas
              <span class="cards-count-badge">3 tarjetas</span>
            </h2>

            <div class="cards-view-toggles">
              <button class="view-toggle-btn active" aria-label="Vista de tarjetas">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                <span>Tarjetas</span>
              </button>
              <button class="view-toggle-btn" aria-label="Vista de cuadrícula">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              </button>
              <button class="view-toggle-btn" aria-label="Vista de lista">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
              </button>
            </div>
          </div>

          <!-- FILA DE TARJETAS VISUALES INTERACTIVAS -->
          <div class="cards-carousel-wrapper">
            <button class="carousel-nav-btn prev" aria-label="Tarjeta anterior">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>

            <div class="cards-cards-grid" id="cards-grid">
              
              <!-- CARD 1: INTERBANK (SELECTED) -->
              <div class="card-item-box selected" 
                   data-bank="Interbank"
                   data-card-type="Visa Débito"
                   data-full-number="1234 5678 9012 3456"
                   data-masked="•••• 3456"
                   data-holder="Joshua Villanueva"
                   data-expiry="12/28"
                   data-limit-total="S/ 10,000.00"
                   data-limit-used="S/ 1,500.00"
                   data-limit-avail="S/ 8,500.00"
                   data-percent="15%"
                   data-theme="interbank">
                
                <div class="card-box-header">
                  <span class="card-badge-principal">Principal</span>
                </div>

                <div class="visual-bank-card interbank-card">
                  <svg class="card-wave-bg" viewBox="0 0 320 200" fill="none" preserveAspectRatio="none">
                    <path d="M-10,180 C60,160 120,80 230,105 C265,115 300,75 330,55" stroke="rgba(124, 58, 237, 0.4)" stroke-width="1.2" />
                    <path d="M-10,195 C70,175 130,95 240,120 C275,128 310,88 340,68" stroke="rgba(124, 58, 237, 0.28)" stroke-width="1.2" />
                    <path d="M-10,210 C80,190 140,110 250,135 C285,142 320,102 350,82" stroke="rgba(124, 58, 237, 0.18)" stroke-width="1.2" />
                    <path d="M-10,225 C90,205 150,125 260,150 C295,158 330,118 360,98" stroke="rgba(124, 58, 237, 0.1)" stroke-width="1.2" />
                  </svg>
                  
                  <div class="card-top-logos">
                    <div class="card-bank-brand">
                      <span class="brand-sq-interbank"></span>
                      <span>Interbank</span>
                    </div>
                    <span class="card-network-logo visa">VISA</span>
                  </div>

                  <div class="card-middle-numbers">
                    <span class="card-full-number">1234 5678 9012 3456</span>
                    <span class="card-masked-digits">•••• 3456</span>
                  </div>

                  <div class="card-footer-info">
                    <span class="card-holder-name">JOSHUA VILLANUEVA</span>
                    <div class="card-expiration-date">
                      <div style="font-size: 0.5rem; opacity: 0.6;">Vence</div>
                      <div>12/28</div>
                    </div>
                  </div>
                </div>

                <div class="card-item-meta">
                  <div class="card-status-indicator">
                    <span class="card-status-dot"></span>
                    <span>Activa</span>
                  </div>
                  <div class="card-limit-row">
                    <span class="limit-label">Límite disponible</span>
                    <span class="limit-amount">S/ 8,500.00</span>
                  </div>
                </div>

                <div class="card-item-actions">
                  <button class="btn-card-details">Ver detalles</button>
                  <div class="card-more-menu-wrapper">
                    <button class="btn-card-more" aria-label="Más opciones">•••</button>
                    <div class="card-dropdown-menu">
                      <button class="dropdown-item item-lock">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span class="dropdown-lock-text">Bloquear tarjeta</span>
                      </button>
                      <button class="dropdown-item item-delete">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        <span>Eliminar tarjeta</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- CARD 2: BBVA -->
              <div class="card-item-box"
                   data-bank="BBVA"
                   data-card-type="Mastercard Crédito"
                   data-full-number="5678 9012 3456 7890"
                   data-masked="•••• 7890"
                   data-holder="Joshua Villanueva"
                   data-expiry="09/27"
                   data-limit-total="S/ 8,000.00"
                   data-limit-used="S/ 2,000.00"
                   data-limit-avail="S/ 6,000.00"
                   data-percent="25%"
                   data-theme="bbva">
                
                <div class="card-box-header">
                  <span class="card-badge-placeholder"></span>
                </div>

                <div class="visual-bank-card bbva-card">
                  <div class="card-top-logos">
                    <div class="card-bank-brand brand-txt-bbva">
                      BBVA
                    </div>
                    <div class="mc-circles" style="transform: scale(1.1);">
                      <span class="mc-c1" style="width: 14px; height: 14px;"></span>
                      <span class="mc-c2" style="width: 14px; height: 14px;"></span>
                    </div>
                  </div>

                  <div class="card-middle-numbers">
                    <span class="card-full-number">5678 9012 3456 7890</span>
                    <span class="card-masked-digits">•••• 7890</span>
                  </div>

                  <div class="card-footer-info">
                    <span class="card-holder-name">JOSHUA VILLANUEVA</span>
                    <div class="card-expiration-date">
                      <div style="font-size: 0.5rem; opacity: 0.6;">Vence</div>
                      <div>09/27</div>
                    </div>
                  </div>
                </div>

                <div class="card-item-meta">
                  <div class="card-status-indicator">
                    <span class="card-status-dot"></span>
                    <span>Activa</span>
                  </div>
                  <div class="card-limit-row">
                    <span class="limit-label">Límite disponible</span>
                    <span class="limit-amount">S/ 6,000.00</span>
                  </div>
                </div>

                <div class="card-item-actions">
                  <button class="btn-card-details">Ver detalles</button>
                  <div class="card-more-menu-wrapper">
                    <button class="btn-card-more" aria-label="Más opciones">•••</button>
                    <div class="card-dropdown-menu">
                      <button class="dropdown-item item-lock">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span class="dropdown-lock-text">Bloquear tarjeta</span>
                      </button>
                      <button class="dropdown-item item-delete">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        <span>Eliminar tarjeta</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- CARD 3: BCP -->
              <div class="card-item-box"
                   data-bank="BCP"
                   data-card-type="Visa Débito"
                   data-full-number="4321 8765 2109 8765"
                   data-masked="•••• 8765"
                   data-holder="Joshua Villanueva"
                   data-expiry="11/29"
                   data-limit-total="S/ 4,000.00"
                   data-limit-used="S/ 0.00"
                   data-limit-avail="S/ 4,000.00"
                   data-percent="0%"
                   data-theme="bcp">
                
                <div class="card-box-header">
                  <span class="card-badge-placeholder"></span>
                </div>
                
                <div class="visual-bank-card bcp-card">
                  <div class="card-top-logos">
                    <div class="card-bank-brand brand-txt-bcp">
                      <span>&gt;</span> BCP
                    </div>
                    <span class="card-network-logo visa">VISA</span>
                  </div>

                  <div class="card-middle-numbers">
                    <span class="card-full-number">4321 8765 2109 8765</span>
                    <span class="card-masked-digits">•••• 8765</span>
                  </div>

                  <div class="card-footer-info">
                    <span class="card-holder-name">JOSHUA VILLANUEVA</span>
                    <div class="card-expiration-date">
                      <div style="font-size: 0.5rem; opacity: 0.6;">Vence</div>
                      <div>11/29</div>
                    </div>
                  </div>
                </div>

                <div class="card-item-meta">
                  <div class="card-status-indicator">
                    <span class="card-status-dot"></span>
                    <span>Activa</span>
                  </div>
                  <div class="card-limit-row">
                    <span class="limit-label">Límite disponible</span>
                    <span class="limit-amount">S/ 4,000.00</span>
                  </div>
                </div>

                <div class="card-item-actions">
