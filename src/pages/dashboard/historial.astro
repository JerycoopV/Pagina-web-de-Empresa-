          <div class="detail-block">
            <h4 class="detail-section-title">Información de operación</h4>
            <div class="detail-key-values">
              <div class="detail-row">
                <span class="detail-key">Monto solicitado</span>
                <span class="detail-val" id="detail-monto-solicitado">S/ 2,000.00</span>
              </div>
              <div class="detail-row">
                <span class="detail-key">Banco</span>
                <span class="detail-val" id="detail-banco-val">
                  <span>Interbank</span>
                  <span class="bank-badge-box interbank" style="width: 16px; height: 16px;">
                    <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
                  </span>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-key">Tipo de tarjeta</span>
                <span class="detail-val" id="detail-tarjeta-val">
                  <span>Visa</span>
                  <span class="card-badge visa" style="font-size: 0.6rem; padding: 1px 4px;">VISA</span>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-key">Fecha</span>
                <span class="detail-val" id="detail-fecha-val">25 Jul 2024 - 14:32</span>
              </div>
              <div class="detail-row">
                <span class="detail-key">ID de operación</span>
                <span class="detail-val" id="detail-id-val" style="font-family: monospace;">CF-00241</span>
              </div>
            </div>
          </div>

          <!-- Resultado de la simulación -->
          <div class="detail-block">
            <h4 class="detail-section-title">Resultado de la simulación</h4>
            <div class="detail-result-box">
              <div class="detail-row">
                <span class="detail-key">Monto disponible</span>
                <span class="detail-val" id="detail-monto-disponible">S/ 2,000.00</span>
              </div>
              <div class="detail-row">
                <span class="detail-key">Comisión</span>
                <span class="detail-val" id="detail-comision-val">S/ 0.00</span>
              </div>
              <div class="detail-final-highlight">
                <span class="final-amount-label">Monto final</span>
                <span class="final-amount-value" id="detail-monto-final">S/ 2,000.00</span>
              </div>
            </div>
          </div>

          <!-- Botón de Descarga de Comprobante -->
          <button class="btn-download-voucher" id="btn-download-voucher">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Descargar comprobante</span>
          </button>
        </aside>

      </section>

    </main>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (!requireSession()) return;

    const operationsBody = document.getElementById('operations-table-body');
    const money = (value: unknown) => `S/ ${Number(value || 0).toLocaleString('es-PE', { minimumFractionDigits: 2 })}`;
    const statusClass = (status: string) => ({ completed: 'completed', approved: 'completed', pending: 'pending', reviewing: 'pending', cancelled: 'cancelled', rejected: 'cancelled' }[status] || 'pending');
    const statusLabel = (status: string) => ({ completed: 'Completada', approved: 'Aprobada', pending: 'Pendiente', reviewing: 'En revisión', cancelled: 'Cancelada', rejected: 'Rechazada' }[status] || status || 'Sin estado');

    if (operationsBody) operationsBody.innerHTML = '<tr><td colspan="7" class="dashboard-empty">Cargando operaciones...</td></tr>';
    document.querySelectorAll('.metric-stat-value').forEach(element => { element.textContent = '0'; });
    document.querySelectorAll('.metric-stat-trend').forEach(element => { element.textContent = ''; });

    const loadOperations = async () => {
      try {
        const result = await apiFetch<{ items?: any[] } | any[]>('/operations?limit=50');
        const items = Array.isArray(result) ? result : result.items || [];
        if (!operationsBody) return;
        operationsBody.innerHTML = items.length ? items.map(operation => {
          const simulation = operation.simulation || operation;
          const status = operation.status || 'pending';
          const date = operation.createdAt ? new Date(operation.createdAt) : null;
          const id = simulation.operationCode || operation.operationCode || operation.id || '-';
          const bank = simulation.bank?.name || simulation.bank || '-';
          const card = simulation.card?.brand || simulation.cardBrand || '-';
          const amount = money(simulation.grossAmount ?? simulation.amount);
          const dateLabel = date ? date.toLocaleString('es-PE', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
          return `<tr class="historial-table-row" data-id="${id}" data-amount="${amount}" data-bank="${bank}" data-card="${card}" data-date="${dateLabel}" data-status="${statusLabel(status)}" data-fee="${money(simulation.fee)}"><td>${dateLabel}</td><td class="cell-op-id">#${id}</td><td class="cell-amount">${amount}</td><td>${bank}</td><td>${card}</td><td><span class="status-pill ${statusClass(status)}"><span class="status-dot-bullet"></span>${statusLabel(status)}</span></td><td><button class="btn-view-details" aria-label="Ver detalles de la operación">Ver detalles →</button></td></tr>`;
        }).join('') : '<tr><td colspan="7" class="dashboard-empty">Aún no tienes operaciones.</td></tr>';
        if (showingText) showingText.textContent = `Mostrando ${items.length} de ${items.length} operaciones`;
        initializeHistoryInteractions();
      } catch {
        if (operationsBody) operationsBody.innerHTML = '<tr><td colspan="7" class="dashboard-empty">No se pudieron cargar las operaciones.</td></tr>';
      }
    };

    // 1. Cargar nombre de usuario si existe
    const savedUser = localStorage.getItem('capitalFest_user');
    if (savedUser) {
      try {
        const parsed = JSON.parse(savedUser);
        const name = parsed.firstName || 'Joshua';
        const initial = name.charAt(0).toUpperCase();
        
        const sideAvatar = document.getElementById('sidebar-avatar-initial');
        const headAvatar = document.getElementById('header-avatar-initial');
        const sideName = document.getElementById('sidebar-user-fullname');
        
        if (sideAvatar) sideAvatar.textContent = initial;
        if (headAvatar) headAvatar.textContent = initial;
        if (sideName) sideName.innerHTML = `${name} V. <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>`;
      } catch (e) {}
    }

    // 2. Toggle del Sidebar en Pantallas Pequeñas con Backdrop
    const mobileBtn = document.getElementById('mobile-sidebar-btn');
    const sidebar = document.getElementById('dash-sidebar');
    const sidebarBackdrop = document.getElementById('sidebar-backdrop');

    function toggleSidebar(open?: boolean) {
      if (!sidebar) return;
      const willOpen = open !== undefined ? open : !sidebar.classList.contains('open');
      sidebar.classList.toggle('open', willOpen);
      sidebarBackdrop?.classList.toggle('active', willOpen);
    }

    if (mobileBtn) {
      mobileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSidebar();
      });
    }

    if (sidebarBackdrop) {
      sidebarBackdrop.addEventListener('click', () => toggleSidebar(false));
    }

    // 3. Cierre de Sesión
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        if (confirm('¿Estás seguro de que deseas cerrar sesión?')) {
          localStorage.removeItem('capitalFest_user');
          window.location.href = '/login';
        }
      });
    }

    // 4. Lógica de Selección de Filas e Interacción con el Panel de Detalles
    let tableRows = document.querySelectorAll('.historial-table-row');
    const workspace = document.getElementById('historial-workspace');
    const detailPanel = document.getElementById('historial-detail-panel');
    detailPanel?.style.setProperty('display', 'none');
    workspace?.classList.add('details-closed');
    const closeDetailBtn = document.getElementById('btn-close-detail');

    // Elementos del Panel de Detalles
    const titleElem = document.getElementById('detail-sim-title');
    const statusWrapper = document.getElementById('detail-status-wrapper');
    const montoSolicitadoElem = document.getElementById('detail-monto-solicitado');
    const bancoValElem = document.getElementById('detail-banco-val');
    const tarjetaValElem = document.getElementById('detail-tarjeta-val');
    const fechaValElem = document.getElementById('detail-fecha-val');
    const idValElem = document.getElementById('detail-id-val');
    const montoDisponibleElem = document.getElementById('detail-monto-disponible');
    const comisionValElem = document.getElementById('detail-comision-val');
    const montoFinalElem = document.getElementById('detail-monto-final');

    function updateDetailPanel(row: HTMLElement) {
      const id = row.dataset.id || 'CF-00241';
      const amount = row.dataset.amount || 'S/ 2,000.00';
      const bank = row.dataset.bank || 'Interbank';
      const card = row.dataset.card || 'Visa';
      const date = row.dataset.date || '25 Jul 2024 - 14:32';
      const status = row.dataset.status || 'Completada';
      const fee = row.dataset.fee || 'S/ 0.00';

      if (titleElem) titleElem.textContent = `Simulación #${id}`;
      if (montoSolicitadoElem) montoSolicitadoElem.textContent = amount;
      if (fechaValElem) fechaValElem.textContent = date;
      if (idValElem) idValElem.textContent = id;
      if (montoDisponibleElem) montoDisponibleElem.textContent = amount;
      if (comisionValElem) comisionValElem.textContent = fee;
      if (montoFinalElem) montoFinalElem.textContent = amount;

      // Status Badge
      if (statusWrapper) {
        let badgeClass = 'completed';
        let iconSvg = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        if (status === 'Pendiente') {
          badgeClass = 'pending';
          iconSvg = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';
        } else if (status === 'Cancelada') {
          badgeClass = 'cancelled';
          iconSvg = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
        }
        statusWrapper.innerHTML = `
          <span class="detail-status-badge ${badgeClass}">
            ${iconSvg}
            <span>${status}</span>
          </span>
        `;
      }

      // Banco
      if (bancoValElem) {
        let bankBadge = '<span class="bank-badge-box interbank" style="width: 16px; height: 16px;"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg></span>';
        if (bank === 'BBVA') {
          bankBadge = '<span class="bank-badge-box bbva" style="width: 16px; height: 16px;"><span style="font-size: 7px; font-weight: 800; color: #fff;">BB</span></span>';
        } else if (bank === 'BCP') {
          bankBadge = '<span class="bank-badge-box bcp" style="width: 16px; height: 16px;"><span style="font-size: 7px; font-weight: 800; color: #fff;">&gt;</span></span>';
        }
        bancoValElem.innerHTML = `<span>${bank}</span> ${bankBadge}`;
      }

      // Tarjeta
      if (tarjetaValElem) {
        let cardBadge = '<span class="card-badge visa" style="font-size: 0.6rem; padding: 1px 4px;">VISA</span>';
        if (card === 'Mastercard') {
          cardBadge = '<span class="card-badge mastercard" style="padding: 2px 4px;"><span class="mc-circles"><span class="mc-c1" style="width: 8px; height: 8px;"></span><span class="mc-c2" style="width: 8px; height: 8px;"></span></span></span>';
        }
        tarjetaValElem.innerHTML = `<span>${card}</span> ${cardBadge}`;
      }

      // Mostrar panel si estaba oculto
      if (workspace && detailPanel) {
        workspace.classList.remove('details-closed');
        detailPanel.style.display = 'flex';
      }
    }

    function initializeHistoryInteractions() {
      tableRows = document.querySelectorAll('.historial-table-row');
      tableRows.forEach(row => {
      row.addEventListener('click', () => {
        tableRows.forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        updateDetailPanel(row as HTMLElement);
      });
      });
    }

    if (closeDetailBtn && workspace && detailPanel) {
      closeDetailBtn.addEventListener('click', () => {
        workspace.classList.add('details-closed');
        detailPanel.style.display = 'none';
      });
    }

    // 5. Filtros en Vivo (Búsqueda, Estado, Banco)
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterStatus = document.getElementById('filter-status') as HTMLSelectElement;
    const filterBank = document.getElementById('filter-bank') as HTMLSelectElement;
    const filterBtn = document.getElementById('btn-apply-filters');
    const showingText = document.getElementById('showing-text');

    function applyFilterLogic() {
      const q = searchInput?.value.toLowerCase().trim() || '';
      const st = filterStatus?.value || 'Todos';
      const bk = filterBank?.value || 'Todos';

      let visibleCount = 0;
      tableRows.forEach(r => {
        const row = r as HTMLElement;
        const id = (row.dataset.id || '').toLowerCase();
        const amount = (row.dataset.amount || '').toLowerCase();
        const bank = row.dataset.bank || '';
        const status = row.dataset.status || '';

        const matchQuery = !q || id.includes(q) || amount.includes(q) || bank.toLowerCase().includes(q);
        const matchStatus = st === 'Todos' || status === st;
        const matchBank = bk === 'Todos' || bank === bk;

        if (matchQuery && matchStatus && matchBank) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (showingText) {
        showingText.textContent = `Mostrando ${visibleCount} de 24 operaciones`;
      }
    }

    if (searchInput) searchInput.addEventListener('input', applyFilterLogic);
    if (filterStatus) filterStatus.addEventListener('change', applyFilterLogic);
    if (filterBank) filterBank.addEventListener('change', applyFilterLogic);
    if (filterBtn) filterBtn.addEventListener('click', applyFilterLogic);

    // 6. Descargar comprobante simulación
    const downloadBtn = document.getElementById('btn-download-voucher');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        const id = (titleElem?.textContent || 'Comprobante').replace('#', '');
        alert(`Descargando comprobante oficial para ${id}...`);
      });
    }
    loadOperations();
  });
</script>
