            </div>
          </div>
        </div>

        <!-- PANEL DERECHO: DETALLE DE SIMULACIÓN SELECCIONADA -->
        <aside class="historial-detail-panel" id="historial-detail-panel">
          <div class="detail-panel-header">
            <h3 class="detail-panel-title" id="detail-sim-title">Simulación #CF-00241</h3>
            <button class="detail-close-btn" id="btn-close-detail" aria-label="Cerrar panel de detalles">
              ✕
            </button>
          </div>

          <!-- Badge de Estado -->
          <div id="detail-status-wrapper">
            <span class="detail-status-badge completed" id="detail-status-badge">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Completada</span>
