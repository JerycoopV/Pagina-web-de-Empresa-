                <!-- Fila 9 -->
                <tr class="historial-table-row" data-id="CF-00233" data-amount="S/ 1,750.00" data-bank="BCP" data-card="Visa" data-date="10 Jul 2024 - 08:37" data-status="Completada" data-fee="S/ 0.00">
                  <td>10 Jul 2024 - 08:37</td>
                  <td class="cell-op-id">#CF-00233</td>
                  <td class="cell-amount">S/ 1,750.00</td>
                  <td>
                    <div class="table-bank-cell">
                      <span class="bank-badge-box bcp">
                        <span style="font-size: 8px; font-weight: 800; color: #fff;">&gt;</span>
                      </span>
                      <span>BCP</span>
                    </div>
                  </td>
                  <td><span class="card-badge visa">VISA</span></td>
                  <td>
                    <span class="status-pill completed">
                      <span class="status-dot-bullet"></span> Completada
                    </span>
                  </td>
                  <td>
                    <button class="btn-view-details" aria-label="Ver detalles de la operación">
                      Ver detalles →
