                <!-- Fila 10 -->
                <tr class="historial-table-row" data-id="CF-00232" data-amount="S/ 2,300.00" data-bank="Interbank" data-card="Visa" data-date="08 Jul 2024 - 17:30" data-status="Completada" data-fee="S/ 0.00">
                  <td>08 Jul 2024 - 17:30</td>
                  <td class="cell-op-id">#CF-00232</td>
                  <td class="cell-amount">S/ 2,300.00</td>
                  <td>
                    <div class="table-bank-cell">
                      <span class="bank-badge-box interbank">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
                      </span>
                      <span>Interbank</span>
                    </div>
                  </td>
                  <td><span class="card-badge visa">VISA</span></td>
                  <td>
                    <span class="status-pill completed">
                      <span class="status-dot-bullet"></span> Completada
                    </span>
                  </td>
                  <td>
                    <button class="btn-view-details" aria-label="Ver detalles de la operación">
                      Ver detalles →
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Paginación de la Tabla -->
          <div class="historial-table-footer">
            <span id="showing-text">Mostrando 1-10 de 24 operaciones</span>
            
            <div class="table-pagination-controls">
              <select class="page-size-select" aria-label="Operaciones por página">
                <option>10 por página</option>
                <option>20 por página</option>
                <option>50 por página</option>
              </select>

              <div class="pagination-pages">
                <button class="page-btn" aria-label="Página anterior" disabled>&lt;</button>
                <button class="page-btn active">1</button>
                <button class="page-btn">2</button>
                <button class="page-btn">3</button>
                <span style="color: var(--text-dim); padding: 0 4px;">...</span>
                <button class="page-btn" aria-label="Página siguiente">&gt;</button>
