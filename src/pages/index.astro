            </svg>
          </div>
          <div>
            <h3>100% Seguro</h3>
            <p>Protegemos tus datos en cada operación.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 27.53 40.71" fill="currentColor">
              <path d="m27.38,15.62c-.24-.47-.67-.73-1.2-.73-.09,0-.18,0-.27.02l-6.76.97c-.66.09-1.31.18-1.97.27l7.42-12.34c.35-.59.71-1.17,1.05-1.76.38-.64.27-1.32-.29-1.76-.25-.2-.53-.3-.81-.3-.33,0-.66.14-.96.41-.08.07-.16.15-.24.23L6.85,17.11c-2.11,2.1-4.21,4.21-6.33,6.31-.52.52-.65,1.06-.39,1.62.23.49.67.77,1.22.77.08,0,.16,0,.24-.02l8.76-1.25s-8,13.31-8.46,14.07c-.39.65-.3,1.31.24,1.76.26.22.55.33.84.33.35,0,.68-.15.98-.44.11-.1.22-.21.37-.37,0,0,20.05-20,22.61-22.56.24-.24.86-.86.43-1.72Zm-15.92,12.24c.8-1.34,1.6-2.67,2.42-4.01.26-.42.64-1.06.14-1.78-.26-.37-.63-.55-1.11-.55-.17,0-.35.02-.55.05l-6.98,1,12.13-12.1-.16.27c-1.23,2.05-2.46,4.09-3.69,6.14-.25.41-.62,1.02-.15,1.73.26.39.64.58,1.14.58.17,0,.35-.02.52-.05l6.93-1-11.95,11.91,1.32-2.2Z"/>
            </svg>
          </div>
          <div>
            <h3>Al instante</h3>
            <p>Recibe tu dinero en minutos.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 39.91 40" fill="currentColor">
              <path d="m0,19.99C0,8.94,8.97-.02,19.98,0c11.02.02,19.95,8.99,19.93,20.04-.02,11.04-8.99,19.99-20.01,19.96C8.91,39.98,0,31,0,19.99Zm4.42-.04c-.02,8.52,6.93,15.58,15.38,15.62,8.62.04,15.66-6.92,15.68-15.49.02-8.59-6.92-15.61-15.47-15.65-8.55-.03-15.57,6.95-15.6,15.52Z"/>
              <path d="m28.81,15.54c.02.64-.23,1.18-.68,1.63-2.92,2.93-5.84,5.87-8.77,8.79-.98.98-2.28.96-3.27-.02-1.44-1.42-2.86-2.85-4.28-4.29-.93-.95-.96-2.31-.08-3.2.86-.88,2.26-.86,3.2.06.83.8,1.65,1.61,2.44,2.45.29.31.45.3.75,0,2.27-2.3,4.55-4.59,6.85-6.87,1.27-1.26,3.19-.84,3.76.79.08.22.09.44.1.67Z"/>
            </svg>
          </div>
          <div>
            <h3>Sin vueltas</h3>
            <p>Proceso simple, claro y sin complicaciones.</p>
          </div>
        </div>
      </div>

      <!-- Botones de Acción de Inicio -->
      <div class="hero-actions animate-on-load delay-4">
        <a href="/simulador" class="btn btn-hero-gradient" id="btn-simular">
          Simular Retiro
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#como-funciona" class="btn btn-hero-outline" id="btn-como-funciona">
          Cómo Funciona
          <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Composición Visual (Tarjeta 3D + Notificación) -->
    <div class="hero-visual animate-on-load delay-5">
        <!-- Imagen de Tarjeta de Inicio Flotante (Pre-renderizada con pedestal y luces) -->
        <img src="/assets/TARJETA-INICIO.webp" alt="Tarjeta Inicio Premium" class="hero-image-floating" />
    </div>
  </div>

  <!-- Barra de Confianza (Trust Bar) -->
  <div class="trust-bar animate-on-scroll" id="trust-bar">
    <div class="trust-item" id="trust-item-seguridad">
      <div class="trust-icon">
