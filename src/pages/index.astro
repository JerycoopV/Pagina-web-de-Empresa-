---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import '../styles/index.css';
---

<Layout title="Inicio | Convierte tu saldo a efectivo">
  <div class="hero-container" id="hero-section">
    <!-- Columna Izquierda: Información y Botones -->
    <div class="hero-content">
      <!-- Badge de Estado -->
      <span class="badge animate-on-load" id="hero-badge">RÁPIDO, SEGURO Y CONFIABLE</span>

      <!-- Título Principal -->
      <h1 class="hero-title animate-on-load delay-1" id="hero-main-title">
        Tu dinero,<br />
        cuando más lo<br />
        <span class="text-gradient">necesites.</span>
      </h1>

      <!-- Subtítulo / Descripción -->
      <p class="hero-description animate-on-load delay-2" id="hero-desc">
        Convierte el saldo de tu tarjeta de crédito en<br />
        efectivo al instante, de forma segura y sin<br />
        vueltas.
      </p>

      <!-- Lista de Beneficios Rápidos (Horizontal) -->
      <div class="features-grid animate-on-load delay-3">
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 11 2 2 4-4"/>
            </svg>
          </div>
          <div>
            <h3>100% Seguro</h3>
            <p>Protegemos tus datos en cada operación.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m13 2-2 10h9L9 22l2-10H2L13 2z"/>
            </svg>
          </div>
          <div>
            <h3>Al instante</h3>
            <p>Recibe tu dinero en minutos.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div>
            <h3>Sin vueltas</h3>
            <p>Proceso simple, claro y sin complicaciones.</p>
          </div>
        </div>
      </div>

      <!-- Botones de Acción de Inicio -->
      <div class="hero-actions animate-on-load delay-4">
        <a href="/simulador" class="btn btn-hero-gradient" id="btn-simular">
          Simular Retiro
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#como-funciona" class="btn btn-hero-outline" id="btn-como-funciona">
          Cómo Funciona
          <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Composición Visual (Tarjeta 3D + Notificación) -->
    <div class="hero-visual animate-on-load delay-5">
        <!-- Imagen de Tarjeta de Inicio Flotante (Pre-renderizada con pedestal y luces) -->
        <img src="/assets/TARJETA-INICIO.webp" alt="Tarjeta Inicio Premium" class="hero-image-floating" />
    </div>
  </div>

  <!-- Barra de Confianza (Trust Bar) -->
  <div class="trust-bar animate-on-scroll" id="trust-bar">
    <div class="trust-item" id="trust-item-seguridad">
      <div class="trust-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <div class="trust-text">
        <h4>Seguridad Bancaria</h4>
        <p>Usamos Tecnología de cifrado de nivel bancario.</p>
      </div>
    </div>

    <div class="trust-item" id="trust-item-transparencia">
      <div class="trust-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 11 11 13 15 9"></polyline>
        </svg>
      </div>
      <div class="trust-text">
        <h4>Transparencia Total</h4>
        <p>Sin costos ocultos. Sabes lo que pagas.</p>
      </div>
    </div>

    <div class="trust-item" id="trust-item-soporte">
      <div class="trust-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          <circle cx="12" cy="12" r="1"></circle>
          <circle cx="8" cy="12" r="1"></circle>
          <circle cx="16" cy="12" r="1"></circle>
        </svg>
      </div>
      <div class="trust-text">
        <h4>Soporte 24/7</h4>
        <p>Estamos para ayudarte cuando lo necesites.</p>
      </div>
    </div>

    <div class="trust-item" id="trust-item-disponibilidad">
      <div class="trust-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="trust-text">
        <h4>Disponibilidad Total</h4>
        <p>Solicita tu retiro cuando y donde quieras.</p>
      </div>
    </div>
  </div>

  <!-- Sección: Proceso de Retiro -->
  <section class="process-section" id="proceso-retiro-section">
    <div class="orange-glow-left"></div>
    <div class="orange-glow-right"></div>

    <h2 class="process-title animate-on-scroll" id="process-main-title">
      Proceso de <span class="text-gradient">Retiro</span>
    </h2>
    <p class="process-subtitle animate-on-scroll" id="process-sub-desc">
      Retira tu dinero de forma rápida, segura y transparente en solo unos pasos
    </p>

    <div class="process-cards stagger-container">
      <!-- Card 1: Registrate -->
      <div class="process-card animate-on-scroll" id="card-registrate">
        <div class="avatar-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <h3>Registrate</h3>
        <p>Crea tu cuenta y verifica tu identidad en minutos para comenzar.</p>
      </div>

      <!-- Card 2: Recibe tu dinero -->
      <div class="process-card animate-on-scroll" id="card-recibe-dinero">
        <div class="avatar-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <h3>Recibe tu dinero</h3>
        <p>Transferimos el dinero directamente a tu cuenta bancaria de forma segura.</p>
      </div>

      <!-- Card 3: Simula tu retiro -->
      <div class="process-card animate-on-scroll" id="card-simula-retiro">
        <div class="avatar-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <h3>Simula tu retiro</h3>
        <p>Elige el monto y revisa exactamente cuando lo recibirás.</p>
      </div>
    </div>
  </section>

  <!-- Carrusel de Bancos (Marquee Infinito de izquierda a derecha) -->
  <div class="bank-carousel-container" id="bancos-carousel">
    <div class="carousel-track">
      <!-- Grupo 1 -->
      <div class="carousel-slide">
        <img src="/assets/banco1.webp" alt="Banco BBVA / BCP" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco2.webp" alt="Banco Interbank" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco3.webp" alt="Banco Pichincha / Scotiabank" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco4.webp" alt="Banco Banbif" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco5.webp" alt="Banco de la Nación" class="bank-logo-img" />
      </div>

      <!-- Grupo 2 (Duplicado para efecto de carrusel continuo) -->
      <div class="carousel-slide">
        <img src="/assets/banco1.webp" alt="Banco BBVA / BCP" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco2.webp" alt="Banco Interbank" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco3.webp" alt="Banco Pichincha / Scotiabank" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco4.webp" alt="Banco Banbif" class="bank-logo-img" />
      </div>
      <div class="carousel-slide">
        <img src="/assets/banco5.webp" alt="Banco de la Nación" class="bank-logo-img" />
      </div>
    </div>
  </div>

  <!-- Sección: Maximiza tus Beneficios -->
  <section class="benefits-section" id="maximiza-beneficios">
    <h2 class="benefits-section-title animate-on-scroll">
      Máximiza tus <span class="text-gradient">Beneficios</span>
    </h2>
    
    <!-- Fila Superior: 3 Cards -->
    <div class="benefits-row top-row stagger-container">
      <!-- Card 1: Rentabilidad -->
      <div class="benefit-row-card animate-on-scroll" id="card-rentabilidad">
        <div class="benefit-img-container">
          <img src="/assets/rentabilidad.webp" alt="Rentabilidad" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Rentabilidad</h3>
          <p>Maximice sus fondos de forma directa.</p>
        </div>
      </div>

      <!-- Card 2: Tasa Preferencial -->
      <div class="benefit-row-card animate-on-scroll" id="card-tasa-preferencial">
        <div class="benefit-img-container">
          <img src="/assets/tasa.webp" alt="Tasa Preferencial" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Tasa Preferencial</h3>
          <p>Solicite condiciones preferenciales vía WhatsApp.</p>
        </div>
      </div>

      <!-- Card 3: Beneficios -->
      <div class="benefit-row-card animate-on-scroll" id="card-beneficios-fest">
        <div class="benefit-img-container">
          <img src="/assets/beneficios.webp" alt="Beneficios" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Beneficios</h3>
          <p>Descuentos y accesos exclusivos en Capital Fest.</p>
        </div>
      </div>
    </div>

    <!-- Fila Inferior: 2 Cards -->
    <div class="benefits-row bottom-row stagger-container">
      <!-- Card 4: Red de Contactos -->
      <div class="benefit-row-card animate-on-scroll" id="card-red-contactos">
        <div class="benefit-img-container">
          <img src="/assets/red.webp" alt="Red de Contactos" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Red de Contactos</h3>
          <p>Conexión directa con nuestra comunidad ejecutiva.</p>
        </div>
      </div>

      <!-- Card 5: Soporte Continuo -->
      <div class="benefit-row-card animate-on-scroll" id="card-soporte-continuo">
        <div class="benefit-img-container">
          <img src="/assets/soporte.webp" alt="Soporte Continuo" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Soporte Continuo</h3>
          <p>Atención y respaldo institucional 24/7.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección: Nuestros Clientes -->
  <section class="clients-section" id="nuestros-clientes">
    <h2 class="clients-title animate-on-scroll">
      Nuestros <span class="text-gradient">Clientes</span>
    </h2>

    <div class="clients-cards stagger-container">
      <!-- Tarjeta Cliente 1 -->
      <div class="process-card animate-on-scroll" id="cliente-1">
        <div class="avatar-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <span class="client-pill">Nombre Apellido</span>
        <p class="client-quote">
          Ser la plataforma financiera de referencia en Perú para el acceso rápido y seguro a efectivo, ofreciendo una experiencia moderna, transparente y sin complicaciones. ofreciendo una experiencia moderna, transparente y sin complicaciones.
        </p>
      </div>

      <!-- Tarjeta Cliente 2 -->
      <div class="process-card animate-on-scroll" id="cliente-2">
        <div class="avatar-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <span class="client-pill">Nombre Apellido</span>
        <p class="client-quote">
          Ser la plataforma financiera de referencia en Perú para el acceso rápido y seguro a efectivo, ofreciendo una experiencia moderna, transparente y sin complicaciones. ofreciendo una experiencia moderna, transparente y sin complicaciones.
        </p>
      </div>

      <!-- Tarjeta Cliente 3 -->
      <div class="process-card animate-on-scroll" id="cliente-3">
        <div class="avatar-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <span class="client-pill">Nombre Apellido</span>
        <p class="client-quote">
          Ser la plataforma financiera de referencia en Perú para el acceso rápido y seguro a efectivo, ofreciendo una experiencia moderna, transparente y sin complicaciones. ofreciendo una experiencia moderna, transparente y sin complicaciones.
        </p>
      </div>
    </div>
  </section>

  <!-- Sección: Banner de Llamado a la Acción (CTA) -->
  <section class="cta-banner-section animate-on-scroll" id="cta-banner">
    <div class="cta-card">
      <span class="badge">RÁPIDO, SEGURO Y CONFIABLE</span>
      
      <h2 class="cta-title">
        Obtén efectivo en <span class="text-gradient">minutos.</span>
      </h2>
      
      <p class="cta-description">
        Convierte el saldo de tu tarjeta de crédito al instante, de forma segura y sin problemas.
      </p>

      <div class="cta-actions">
        <a href="/simulador" class="btn btn-hero-gradient" id="cta-btn-simular">
          Simular retiro
        </a>
        <a href="#como-funciona" class="btn-cta-outline" id="cta-btn-como-funciona">
          Cómo funciona
        </a>
      </div>

      <div class="cta-footer-text">
        100% Seguro • Sin complicaciones • Respuesta inmediata
      </div>
    </div>
  </section>

  <!-- Script de Intersección para Animaciones de Scroll Premium -->
  <script>
    // Configuración del Observador de Intersección
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -80px 0px', // Activa la animación un poco antes de que entre del todo en pantalla
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target); // Solo animar una vez al entrar
        }
      });
    }, observerOptions);

    // Observar todos los elementos designados para animarse al deslizar
    const scrollElements = document.querySelectorAll('.animate-on-scroll');
    scrollElements.forEach(el => observer.observe(el));
  </script>
</Layout>
