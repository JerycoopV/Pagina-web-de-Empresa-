---
import Layout from '../layouts/Layout.astro';
import '../styles/dashboard.css';
---

<Layout title="Dashboard | Capital Fest" hideHeaderFooter={true}>
  <div class="dashboard-layout">
    
    <!-- Botón Toggle de Sidebar en Pantallas Móviles -->
    <button class="mobile-sidebar-toggle" id="mobile-sidebar-btn" aria-label="Abrir menú de navegación">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- ==========================================
         1. BARRA LATERAL (SIDEBAR NAVIGATION)
         ========================================== -->
    <aside class="dash-sidebar" id="dash-sidebar">
      <div class="sidebar-top">
        <!-- Logo Principal -->
        <a href="/" class="sidebar-logo">
          <img src="/assets/logo.svg" alt="Capital Fest Logo" class="sidebar-logo-img" />
        </a>

        <!-- Lista de Enlaces de Navegación -->
        <nav>
          <ul class="sidebar-nav">
            <li class="nav-section-title">Dashboard</li>
            
            <li>
              <a href="/dashboard" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                  <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                </svg>
                <span>Inicio</span>
              </a>
            </li>

            <li>
              <a href="/dashboard/historial" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Historial</span>
              </a>
            </li>

            <li>
              <a href="/dashboard/tarjetas" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span>Mis tarjetas</span>
              </a>
            </li>
          </ul>
        </nav>

        <!-- Tarjeta de Información de Seguridad -->
        <div class="sidebar-security-card">
          <div class="security-header">
            <div class="security-icon-box">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <span class="security-title">Tu seguridad es nuestra prioridad</span>
          </div>
          <p class="security-desc">Sistema 100% seguro y encriptado.</p>
          <button class="security-btn-pill" aria-label="Más información">
            <span>Más información</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Pie del Sidebar: Usuario y Cierre de Sesión -->
      <div class="sidebar-bottom">
        <div class="sidebar-user-row" id="user-profile-row">
          <div class="user-avatar" id="sidebar-avatar-initial">J</div>
          <div class="user-info">
            <span class="user-name" id="sidebar-user-fullname">Joshua V.</span>
            <span class="user-link">Ver perfil <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
          </div>
        </div>

        <button class="sidebar-logout-btn" id="logout-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <!-- ==========================================
         2. CONTENIDO PRINCIPAL DEL DASHBOARD
         ========================================== -->
    <main class="dash-content">
      
      <!-- HEADER DEL DASHBOARD: SALUDO + ACCIONES + TARJETA 3D -->
      <header class="dash-top-bar">
        <div class="dash-greeting-box">
          <h1 class="dash-greeting-title">¡Hola, <span class="highlight-name" id="greeting-name">Usuario</span>!</h1>
          <p class="dash-greeting-subtitle">Bienvenido a tu panel de control</p>
        </div>

        <div class="dash-top-actions">
          <button class="notification-btn" aria-label="Notificaciones">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="notification-badge" id="notification-count">0</span>
          </button>
          
          <div class="top-user-avatar" id="header-avatar-initial">J</div>
        </div>

        <!-- Tarjeta Flotante 3D (Elemento Gráfico del Encabezado) -->
        <div class="header-card-visual">
          <div class="visual-pedestal"></div>
          <div class="visual-3d-card">
            <div class="card-top-icons">
              <div class="card-chip"></div>
              <svg class="card-contactless" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8.5 14.5A4 4 0 0 1 8.5 9.5"></path>
                <path d="M11.5 17.5A8 8 0 0 0 11.5 6.5"></path>
                <path d="M14.5 20.5A12 12 0 0 0 14.5 3.5"></path>
              </svg>
            </div>
            <div class="card-number-dots" id="header-card-number">•••• •••• •••• ••••</div>
            <div class="card-bottom-info">
              <span class="card-holder" id="header-card-holder">SIN TARJETA</span>
              <span class="card-expiry" id="header-card-expiry">--/--</span>
            </div>
          </div>
        </div>
      </header>

      <!-- ==========================================
           3. GRILLA DE MÉTRICAS Y ESTADÍSTICAS (4 CARDS)
           ========================================== -->
      <section class="dash-metrics-grid">
        <!-- Card 1: Monto disponible -->
        <div class="metric-card">
          <div class="metric-header">
            <div class="metric-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
                <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
                <path d="M18 12a2 2 0 0 0 0 4h4v-4z"></path>
              </svg>
            </div>
            <div class="metric-info">
                <span class="metric-label" id="available-label">Monto disponible</span>
              <span class="metric-value" id="available-amount">S/ 0.00</span>
            </div>
          </div>
          <div class="metric-footer">
            <span class="metric-footer-text" id="available-description">Línea de crédito disponible</span>
            <span class="metric-tag positive" id="available-change"></span>
          </div>
        </div>

        <!-- Card 2: Retiro máximo -->
        <div class="metric-card">
          <div class="metric-header">
            <div class="metric-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <div class="metric-info">
                <span class="metric-label" id="maximum-label">Retiro máximo</span>
              <span class="metric-value" id="maximum-withdrawal">S/ 0.00</span>
            </div>
          </div>
          <div class="metric-footer">
            <span class="metric-footer-text" id="maximum-description">Monto máximo por retiro</span>
            <span class="metric-tag positive" id="withdrawal-change"></span>
          </div>
        </div>

        <!-- Card 3: Simulaciones realizadas -->
        <div class="metric-card">
          <div class="metric-header">
            <div class="metric-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <div class="metric-info">
                <span class="metric-label" id="simulations-label">Simulaciones realizadas</span>
              <span class="metric-value" id="simulations-count">0</span>
            </div>
          </div>
          <div class="metric-footer">
            <span class="metric-footer-text" id="simulations-description">Este mes</span>
            <span class="metric-tag positive" id="simulations-change"></span>
          </div>
        </div>

        <!-- Card 4: Estado de cuenta -->
        <div class="metric-card">
          <div class="metric-header">
            <div class="metric-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </div>
            <div class="metric-info">
                <span class="metric-label" id="account-label">Estado de cuenta</span>
              <span class="metric-value status-verified" id="account-status">
                Sin verificar
                <svg class="verified-badge-icon" viewBox="0 0 20 20" width="18" height="18" fill="none">
                  <circle cx="10" cy="10" r="9.5" fill="#22c55e" />
                  <path d="M6 10.2L8.8 13L14.4 7.4" stroke="#0a0814" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </div>
          <div class="metric-footer">
            <span class="metric-footer-text" id="account-status-description">Estado actual de la cuenta</span>
          </div>
        </div>
      </section>

      <!-- ==========================================
           4. FILA CENTRAL: GRÁFICO + SIMULACIÓN RÁPIDA (2:1)
           ========================================== -->
      <section class="dash-middle-grid">
        
        <!-- Panel Izquierdo: Simulaciones de Retiro (Gráfico) -->
        <div class="dash-panel" id="quick-simulation-panel">
          <div class="panel-header">
            <div class="panel-title-group">
              <h2 class="panel-title">Simulaciones de retiro</h2>
              <p class="panel-subtitle">Resumen de simulaciones en los últimos 30 días</p>
            </div>
            <select class="panel-filter-select">
              <option>Últimos 30 días</option>
              <option>Últimos 60 días</option>
              <option>Este año</option>
            </select>
          </div>

          <!-- Gráfico SVG Interactivo de Ondas Spline -->
          <div class="chart-container">
            <!-- Tooltip Flotante sobre 25 Jul -->
            <div class="chart-empty-state" id="chart-empty-state">Aún no hay simulaciones para mostrar.</div>

            <svg class="chart-svg" id="dashboard-chart" viewBox="0 0 600 200" preserveAspectRatio="none">
              <defs>
                <linearGradient id="purple-chart-gradient" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#a855f7" stop-opacity="0.45"></stop>
                  <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.0"></stop>
                </linearGradient>
              </defs>

              <!-- Líneas de Guía Horizontales Y -->
              <line x1="40" y1="20" x2="590" y2="20" class="chart-grid-line"></line>
              <text x="10" y="24" class="chart-axis-label">5K</text>

              <line x1="40" y1="55" x2="590" y2="55" class="chart-grid-line"></line>
              <text x="10" y="59" class="chart-axis-label">4K</text>

              <line x1="40" y1="90" x2="590" y2="90" class="chart-grid-line"></line>
              <text x="10" y="94" class="chart-axis-label">3K</text>

              <line x1="40" y1="125" x2="590" y2="125" class="chart-grid-line"></line>
              <text x="10" y="129" class="chart-axis-label">2K</text>

              <line x1="40" y1="160" x2="590" y2="160" class="chart-grid-line"></line>
              <text x="10" y="164" class="chart-axis-label">1K</text>

              <line x1="40" y1="190" x2="590" y2="190" class="chart-grid-line"></line>
              <text x="10" y="194" class="chart-axis-label">0</text>

                <g id="chart-data"></g>
            </svg>
          </div>
        </div>

        <!-- Panel Derecho: Nueva Simulación Rápida -->
        <div class="dash-panel">
          <div class="panel-header">
            <div class="panel-title-group">
              <h2 class="panel-title" id="quick-panel-title">Nueva simulación rápida</h2>
              <p class="panel-subtitle" id="quick-panel-subtitle">Simula tu retiro en segundos</p>
            </div>
          </div>

          <form class="quick-sim-form" id="quick-sim-form">
            <div class="sim-input-group">
              <label class="sim-input-label" id="quick-amount-label">Monto a retirar</label>
              <input type="number" min="1400" step="0.01" class="sim-amount-input" placeholder="Ingresa un monto" id="quick-sim-amount" />
            </div>

            <div class="sim-selectors-row">
              <!-- Selector 1: Banco -->
              <div class="custom-select-wrapper">
                <label class="sim-input-label" id="quick-bank-label">Selecciona tu banco</label>
                <select class="sim-select-box" id="quick-sim-bank">
                  <option value="">Selecciona un banco</option>
                </select>
              </div>

              <!-- Selector 2: Tipo de Tarjeta -->
              <div class="custom-select-wrapper">
                <label class="sim-input-label" id="quick-card-label">Tipo de tarjeta</label>
                <select class="sim-select-box" id="quick-sim-card">
                  <option value="">Selecciona una tarjeta</option>
                </select>
              </div>
            </div>

            <button type="submit" class="sim-submit-btn" id="btn-quick-sim">
              <span id="quick-submit-label">Simular retiro</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </form>
        </div>
      </section>

      <!-- ==========================================
           5. FILA INFERIOR: HISTORIAL + ACTIVIDAD RECIENTE (2:1)
           ========================================== -->
      <section class="dash-bottom-grid">
        
        <!-- Panel Izquierdo: Historial Reciente -->
        <div class="dash-panel">
          <div class="panel-header">
            <div class="panel-title-group">
              <h2 class="panel-title">Historial reciente</h2>
              <p class="panel-subtitle">Tus últimas simulaciones</p>
            </div>
          </div>

          <div class="table-responsive">
            <table class="history-table">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Monto</th>
                  <th>Banco</th>
                  <th>Tarjeta</th>
                  <th>Estado</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="recent-operations-body"><tr><td colspan="6" class="dashboard-empty">Aún no tienes operaciones.</td></tr></tbody>
            </table>
          </div>

          <a href="/dashboard/historial" class="panel-footer-link">
            Ver todo el historial <span>→</span>
          </a>
        </div>

        <!-- Panel Derecho: Actividad Reciente -->
        <div class="dash-panel">
          <div class="panel-header">
            <div class="panel-title-group">
              <h2 class="panel-title">Actividad reciente</h2>
            </div>
          </div>

          <div class="activity-list" id="recent-activity-list"><p class="dashboard-empty">Aún no hay actividad reciente.</p></div>

          <a href="#" class="panel-footer-link">
            Ver toda la actividad <span>→</span>
          </a>
        </div>
      </section>

    </main>
  </div>
</Layout>

<script>
  const api = import.meta.env.PUBLIC_API_URL;
  const token = localStorage.getItem('capitalFest_token');
  const headers = { Authorization: `Bearer ${token}` };
  const money = (value: number) => `S/ ${Number(value || 0).toLocaleString('es-PE', { minimumFractionDigits: 2 })}`;
  const user = JSON.parse(localStorage.getItem('capitalFest_user') || '{}');
  const role = user.role;
  const roleName = typeof role === 'string' ? role : role?.name;
  const isAdmin = [roleName, user.roleName, user.userRole].some(value => String(value || '').toLowerCase() === 'admin') || Number(user.roleId) === 2;
  // TEMPORAL: Desactivada redirección automática de admin para poder probar dashboard de usuario libremente
  // if (isAdmin) window.location.replace('/admin');
  const firstName = user.firstName || 'Joshua';
  const lastName = user.lastName || 'Valverde';
  const initial = firstName.charAt(0).toUpperCase();
  document.getElementById('greeting-name').textContent = firstName;
  document.getElementById('sidebar-user-fullname').textContent = `${firstName} ${lastName.charAt(0) ? `${lastName.charAt(0)}.` : ''}`;
  document.getElementById('sidebar-avatar-initial').textContent = initial;
  document.getElementById('header-avatar-initial').textContent = initial;
  if (isAdmin) {
    const navigation = document.querySelectorAll('.sidebar-nav .nav-item');
    const adminLinks = [['/admin', 'Inicio'], ['/admin/resumen', 'Resumen'], ['/admin/validaciones', 'Validaciones KYC'], ['/admin/usuarios', 'Usuarios'], ['/admin/tarjetas', 'Tarjetas']];
    adminLinks.forEach(([href, label], index) => { const link = navigation[index] as HTMLAnchorElement; if (link) { link.href = href; const text = link.querySelector('span'); if (text) text.textContent = label; } });
    navigation.forEach((link, index) => { if (index >= adminLinks.length) (link.parentElement as HTMLElement).style.display = 'none'; });
  }

  const setText = (id: string, value: string) => { const element = document.getElementById(id); if (element) element.textContent = value; };
  const statusLabel = (status: string) => ({ active: 'Verificada', verified: 'Verificada', pending_verification: 'Pendiente', pending: 'Pendiente', blocked: 'Bloqueada', rejected: 'Rechazada' }[status] || status || 'Sin datos');
  const populateNormalDemo = () => {
    setText('available-amount', 'S/ 35,000.00'); setText('maximum-withdrawal', 'S/ 4,500.00'); setText('simulations-count', '3'); setText('account-status', 'Verificada'); setText('account-status-description', 'Cuenta en buen estado');
    setText('available-change', '▲ 12%'); setText('withdrawal-change', '▲ 8%'); setText('simulations-change', '+2');
    setText('header-card-number', '1234 5678 9012 3456'); setText('header-card-holder', 'TU TARJETA'); setText('header-card-expiry', '12/25'); setText('notification-count', '3');
    const chartData = document.getElementById('chart-data');
    if (chartData) chartData.innerHTML = `<text x="50" y="200" class="chart-axis-label">25 Jun</text><text x="135" y="200" class="chart-axis-label">30 Jun</text><text x="220" y="200" class="chart-axis-label">5 Jul</text><text x="305" y="200" class="chart-axis-label">10 Jul</text><text x="390" y="200" class="chart-axis-label">15 Jul</text><text x="475" y="200" class="chart-axis-label">20 Jul</text><text x="550" y="200" class="chart-axis-label">25 Jul</text><path d="M 50,150 C 80,110 110,140 145,130 C 180,120 200,145 230,135 C 260,125 290,160 325,120 C 350,90 375,40 400,60 C 425,80 445,120 470,110 C 495,100 520,70 560,95 L 560,190 L 50,190 Z" class="chart-area-fill"></path><path d="M 50,150 C 80,110 110,140 145,130 C 180,120 200,145 230,135 C 260,125 290,160 325,120 C 350,90 375,40 400,60 C 425,80 445,120 470,110 C 495,100 520,70 560,95" class="chart-path-line"></path><circle cx="560" cy="95" class="chart-point"></circle>`;
    const chartEmpty = document.getElementById('chart-empty-state'); if (chartEmpty) chartEmpty.remove();
    const operationsBody = document.getElementById('recent-operations-body');
    if (operationsBody) operationsBody.innerHTML = `<tr><td>25 Jul 2026</td><td style="font-weight:600;">S/ 2,000.00</td><td>Interbank</td><td><span class="visa-badge">VISA</span></td><td><span class="status-badge completed"><span class="status-dot completed"></span>Completada</span></td><td><span class="table-action-dots">•••</span></td></tr><tr><td>23 Jul 2026</td><td style="font-weight:600;">S/ 1,000.00</td><td>BBVA</td><td><span class="visa-badge">MC</span></td><td><span class="status-badge completed"><span class="status-dot completed"></span>Completada</span></td><td><span class="table-action-dots">•••</span></td></tr><tr><td>21 Jul 2026</td><td style="font-weight:600;">S/ 3,000.00</td><td>BCP</td><td><span class="visa-badge">VISA</span></td><td><span class="status-badge pending"><span class="status-dot pending"></span>Pendiente</span></td><td><span class="table-action-dots">•••</span></td></tr>`;
    const activity = document.getElementById('recent-activity-list');
    if (activity) activity.innerHTML = `<div class="activity-item"><div class="activity-icon-circle"><span>✓</span></div><div class="activity-details"><span class="activity-title">Simulación completada</span><span class="activity-desc">Retiro de S/ 2,000.00 en Interbank</span></div><span class="activity-time">Hace 2 min</span></div><div class="activity-item"><div class="activity-icon-circle"><span>✓</span></div><div class="activity-details"><span class="activity-title">Simulación completada</span><span class="activity-desc">Retiro de S/ 1,500.00 en BBVA</span></div><span class="activity-time">Hace 1 día</span></div><div class="activity-item"><div class="activity-icon-circle"><span>+</span></div><div class="activity-details"><span class="activity-title">Nueva simulación creada</span><span class="activity-desc">Retiro de S/ 3,000.00 en BCP</span></div><span class="activity-time">Hace 2 días</span></div>`;
    const amount = document.getElementById('quick-sim-amount') as HTMLInputElement | null; if (amount) { amount.value = '2000'; amount.type = 'text'; }
    const bank = document.getElementById('quick-sim-bank') as HTMLSelectElement | null; if (bank) bank.innerHTML = '<option value="Interbank">Interbank</option><option value="BBVA">BBVA</option><option value="BCP">BCP</option>';
    const card = document.getElementById('quick-sim-card') as HTMLSelectElement | null; if (card) card.innerHTML = '<option value="Visa">Visa</option><option value="Mastercard">Mastercard</option>';
  };
  const loadDashboard = async () => {
    // TEMPORAL: Modo demo - si no hay token o no es admin, carga datos demo de inmediato
    if (!token) { populateNormalDemo(); return; }
    if (!isAdmin) { populateNormalDemo(); return; }
    const basePath = isAdmin ? '/admin' : '';
    const [summaryResponse, cardsResponse, notificationsResponse] = await Promise.all([
      fetch(`${api}${basePath}${isAdmin ? '/dashboard' : '/dashboard/summary'}`, { headers }),
      fetch(`${api}/cards`, { headers }),
      fetch(`${api}/notifications`, { headers }),
      Promise.resolve({ ok: false, json: async () => ({ items: [] }) }),
    ]);
    if (!summaryResponse.ok) return;
    const summary = await summaryResponse.json();
    const metrics = summary.metrics;
    if (isAdmin) {
      setText('available-label', 'Volumen procesado'); setText('available-description', 'Volumen bruto acumulado');
      setText('maximum-label', 'Usuarios pendientes'); setText('maximum-description', 'Cuentas por revisar');
      setText('simulations-label', 'Usuarios registrados'); setText('simulations-description', 'Usuarios activos en el sistema');
      setText('account-label', 'Estado del sistema'); setText('account-status', 'Operativo'); setText('account-status-description', 'Panel administrativo conectado');
      setText('available-amount', money(metrics.grossVolume)); setText('maximum-withdrawal', String(metrics.pendingUsers || 0)); setText('simulations-count', String(metrics.users || 0));
      setText('quick-panel-title', 'Usuarios pendientes'); setText('quick-panel-subtitle', 'Revisa las cuentas del sistema');
      setText('quick-amount-label', 'Cuentas por revisar'); setText('quick-bank-label', 'Estado'); setText('quick-card-label', 'Periodo'); setText('quick-submit-label', 'Ver usuarios');
      const quickForm = document.getElementById('quick-sim-form');
      quickForm?.querySelector('#quick-sim-amount')?.setAttribute('disabled', 'true');
      quickForm?.querySelector('#quick-sim-bank')?.setAttribute('disabled', 'true');
      quickForm?.querySelector('#quick-sim-card')?.setAttribute('disabled', 'true');
      const quickAmount = document.getElementById('quick-sim-amount') as HTMLInputElement | null;
      if (quickAmount) quickAmount.value = String(metrics.pendingUsers || 0);
      const quickButton = document.getElementById('btn-quick-sim');
      quickButton?.addEventListener('click', (event) => { event.preventDefault(); window.location.href = '/admin/usuarios'; });
    } else {
      setText('available-amount', money(metrics.availableAmount));
      setText('maximum-withdrawal', money(metrics.maximumWithdrawal));
      setText('simulations-count', String(metrics.simulationsThisMonth || 0));
      setText('account-status', statusLabel(summary.accountStatus));
      setText('account-status-description', summary.accountStatus === 'verified' || summary.accountStatus === 'active' ? 'Cuenta en buen estado' : 'Revisa el estado de tu cuenta');
    }
    setText('available-change', ''); setText('withdrawal-change', ''); setText('simulations-change', '');
    const operationPayload = { items: [] };
    const operations = isAdmin ? (operationPayload.items || []) : (summary.recentOperations || []);
    const operationsBody = document.getElementById('recent-operations-body');
    if (operationsBody && operations.length) operationsBody.innerHTML = operations.map((operation: any) => `<tr><td>${new Date(operation.createdAt).toLocaleDateString('es-PE')}</td><td style="font-weight:600;">${money(operation.simulation?.grossAmount)}</td><td>${operation.simulation?.bank?.name || '-'}</td><td>****</td><td><span class="status-badge pending"><span class="status-dot pending"></span>${operation.status}</span></td><td><span class="table-action-dots">•••</span></td></tr>`).join('');
    const activity = document.getElementById('recent-activity-list');
    if (activity && operations.length) activity.innerHTML = operations.map((operation: any) => `<div class="activity-item"><div class="activity-icon-circle"><span>+</span></div><div class="activity-details"><span class="activity-title">Operación ${operation.status}</span><span class="activity-desc">${money(operation.simulation?.grossAmount)}${operation.simulation?.bank?.name ? ` en ${operation.simulation.bank.name}` : ''}</span></div><span class="activity-time">${new Date(operation.createdAt).toLocaleDateString('es-PE')}</span></div>`).join('');
    if (!isAdmin && cardsResponse.ok) {
      const cards = await cardsResponse.json(); const bankSelect = document.getElementById('quick-sim-bank') as HTMLSelectElement; const cardSelect = document.getElementById('quick-sim-card') as HTMLSelectElement;
      const firstCard = cards[0];
      setText('header-card-number', firstCard ? `•••• •••• •••• ${firstCard.lastFourDigits}` : '•••• •••• •••• ••••');
      setText('header-card-holder', firstCard?.holderName?.toUpperCase() || 'SIN TARJETA');
      setText('header-card-expiry', firstCard ? `${String(firstCard.expirationMonth).padStart(2, '0')}/${String(firstCard.expirationYear).slice(-2)}` : '--/--');
      bankSelect.innerHTML = cards.length ? cards.map((card: any) => `<option value="${card.bankId || card.bank}">${card.bank}</option>`).join('') : '<option value="">Sin tarjetas vinculadas</option>';
      cardSelect.innerHTML = cards.length ? cards.map((card: any) => `<option value="${card.id}">${card.brand || 'Tarjeta'} **** ${card.lastFourDigits}</option>`).join('') : '<option value="">Sin tarjetas vinculadas</option>';
    }
    if (notificationsResponse.ok) { const notifications = await notificationsResponse.json(); setText('notification-count', String(notifications.filter((notification: any) => !notification.readAt).length)); }
  };
  document.getElementById('logout-btn')?.addEventListener('click', () => { localStorage.removeItem('capitalFest_token'); localStorage.removeItem('capitalFest_user'); window.location.href = '/login'; });
  document.getElementById('quick-sim-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const amount = Number((document.getElementById('quick-sim-amount') as HTMLInputElement).value); const cardId = (document.getElementById('quick-sim-card') as HTMLSelectElement).value; const bankId = Number((document.getElementById('quick-sim-bank') as HTMLSelectElement).value); if (!amount || !cardId || !bankId) return; const response = await fetch(`${api}/simulations`, { method: 'POST', headers: { ...headers, 'Content-Type': 'application/json' }, body: JSON.stringify({ amount, cardId, bankId }) }); if (response.ok) window.location.reload(); });
  const mobileSidebarBtn = document.getElementById('mobile-sidebar-btn'); const dashSidebar = document.getElementById('dash-sidebar'); const sidebarBackdrop = document.getElementById('sidebar-backdrop'); const toggleSidebar = (open?: boolean) => { const willOpen = open !== undefined ? open : !dashSidebar.classList.contains('open'); dashSidebar.classList.toggle('open', willOpen); sidebarBackdrop?.classList.toggle('active', willOpen); }; mobileSidebarBtn?.addEventListener('click', () => toggleSidebar()); sidebarBackdrop?.addEventListener('click', () => toggleSidebar(false));
  loadDashboard();
</script>
