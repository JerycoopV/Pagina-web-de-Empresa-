<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Obtener datos de usuario de localStorage si están disponibles
    const userStr = localStorage.getItem('capitalFest_user');
    const greetingNameEl = document.getElementById('greeting-name');
    const sidebarUserFullname = document.getElementById('sidebar-user-fullname');
    const sidebarAvatar = document.getElementById('sidebar-avatar-initial');
    const headerAvatar = document.getElementById('header-avatar-initial');

    if (userStr) {
      try {
        const user = JSON.parse(userStr);
        const firstName = user.firstName || 'Joshua';
        const lastName = user.lastName || 'V.';
        const initial = firstName.charAt(0).toUpperCase();

        if (greetingNameEl) greetingNameEl.textContent = `${firstName}`;
        if (sidebarUserFullname) sidebarUserFullname.textContent = `${firstName} ${lastName.charAt(0)}.`;
        if (sidebarAvatar) sidebarAvatar.textContent = initial;
        if (headerAvatar) headerAvatar.textContent = initial;
      } catch (e) {
        console.error('Error parseando datos de usuario:', e);
      }
    }

    // 2. Lógica del Botón de Cierre de Sesión
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('capitalFest_token');
        localStorage.removeItem('capitalFest_user');
        window.location.href = '/login';
      });
    }

    // 3. Toggle Sidebar Móvil con Backdrop
    const mobileSidebarBtn = document.getElementById('mobile-sidebar-btn');
    const dashSidebar = document.getElementById('dash-sidebar');
    const sidebarBackdrop = document.getElementById('sidebar-backdrop');

    function toggleSidebar(open?: boolean) {
      if (!dashSidebar) return;
      const willOpen = open !== undefined ? open : !dashSidebar.classList.contains('open');
      dashSidebar.classList.toggle('open', willOpen);
      sidebarBackdrop?.classList.toggle('active', willOpen);
    }

    if (mobileSidebarBtn) {
      mobileSidebarBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSidebar();
      });
    }

    if (sidebarBackdrop) {
      sidebarBackdrop.addEventListener('click', () => toggleSidebar(false));
    }

    // 4. Formulario de Simulación Rápida
    const quickSimForm = document.getElementById('quick-sim-form');
    if (quickSimForm) {
      quickSimForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const amount = (document.getElementById('quick-sim-amount') as HTMLInputElement).value;
        const bank = (document.getElementById('quick-sim-bank') as HTMLSelectElement).value;
        const card = (document.getElementById('quick-sim-card') as HTMLSelectElement).value;

        alert(`¡Simulación iniciada!\nMonto: ${amount}\nBanco: ${bank}\nTarjeta: ${card}`);
      });
    }
  });
</script>
