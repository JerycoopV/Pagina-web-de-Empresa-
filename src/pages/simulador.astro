---
import Layout from '../layouts/Layout.astro';
import '../styles/simulador.css';
---

<Layout title="Simulador de Retiro | Capital Fest">
  <section class="simulador-section">
    <div class="simulador-container">
      
      <!-- Lado Izquierdo -->
      <div class="simulador-info">
        <h1 class="simulador-title animate-on-load">
          Simula tu retiro<br />
          al <span class="text-gradient">instante</span>
        </h1>
        <p class="simulador-description animate-on-load delay-1">
          Ingresa el monto disponible de tu tarjeta y visualiza tu retiro estimado en segundos.
        </p>
        <img src="/assets/TARJETA-2.webp" alt="Simulador Capital Fest" class="simulador-image animate-on-load delay-2" />
      </div>

      <!-- Lado Derecho: Calculadora -->
      <div class="simulador-card-wrapper animate-on-load delay-3">
        <div class="simulador-card">
          <h2>Calcula tu retiro</h2>
          
          <div class="form-group">
            <label>Tipo de calculo</label>
            <input type="text" class="form-input" id="calc-type" value="Retiro de Efectivo" readonly />
          </div>

          <div class="form-group">
            <label>Digitar monto:</label>
            <input type="number" id="monto-input" class="form-input" placeholder="Ej: 1,400.00" min="0" step="any" />
          </div>

          <div class="result-box">
            <div class="result-label">Recibirás:</div>
            <div class="result-amount">
              <span>s/</span> <span id="monto-result">0</span>
            </div>
            <div class="result-note">Estimación rápida y sin compromiso</div>
          </div>

          <button class="btn-submit" id="btn-solicitar">
            Solicitar retiro ahora
          </button>
          
          <div class="footer-note">
            Sin papeleos • 100% online • Respuesta inmediata
          </div>

        </div>
      </div>

    </div>
    
    <!-- Línea decorativa al final -->
    <div class="simulador-divider"></div>
  </section>
</Layout>
<script>
  const initSimulador = () => {
    const montoInput = document.getElementById('monto-input') as HTMLInputElement;
    const montoResult = document.getElementById('monto-result') as HTMLSpanElement;
    const btnSolicitar = document.getElementById('btn-solicitar') as HTMLButtonElement;
    const resultNote = document.querySelector('.result-note') as HTMLDivElement;

    // Lógica del simulador (100% en el Frontend)
    const calcularRetiro = () => {
      let monto = parseFloat(montoInput.value);
      if (isNaN(monto) || monto <= 0) {
        montoResult.textContent = '0';
        resultNote.textContent = 'Estimación rápida y sin compromiso';
        resultNote.style.color = '';
        btnSolicitar.disabled = false;
        btnSolicitar.style.opacity = '1';
        return null; // Retornamos null si no es válido
      }
      
      let comision = 0;
      let feePercentage = 0;
      if (monto < 1500) {
        feePercentage = 1;
        comision = monto * 0.01; // 1%
      } else {
        feePercentage = 2;
        comision = monto * 0.02; // 2%
      }

      if (monto < 1400) {
        montoResult.textContent = '0';
        resultNote.textContent = `❌ Monto insuficiente. Ingresa S/ 1,400 o más.`;
        resultNote.style.color = '#ff4d4d'; // Color rojo para error
        btnSolicitar.disabled = true;
        btnSolicitar.style.opacity = '0.5';
        return null;
      } else {
        const recibir = monto - comision;
        
        // Formatear con separadores de miles
        montoResult.textContent = recibir.toLocaleString('en-US', {
          minimumFractionDigits: 0,
          maximumFractionDigits: 2
        });
        
        resultNote.textContent = `✅ Operación exitosa. Tarifa a cobrar: ${comision.toFixed(2)} soles.`;
        resultNote.style.color = '#4CAF50'; // Color verde para éxito
        btnSolicitar.disabled = false;
        btnSolicitar.style.opacity = '1';

        return {
          grossAmount: monto,
          feePercentage: feePercentage,
          feeAmount: comision,
          netAmount: recibir
        };
      }
    };

    montoInput.addEventListener('input', calcularRetiro);
    
    // También recalcular si el tipo de cálculo cambia
    const calcType = document.getElementById('calc-type');
    if(calcType) {
        calcType.addEventListener('change', calcularRetiro);
    }

    // Mostrar alerta con el monto completo al hacer clic en el número truncado
    montoResult.addEventListener('click', () => {
      let monto = parseFloat(montoInput.value);
      if (!isNaN(monto) && monto > 0) {
        let comision = (monto < 1500) ? monto * 0.01 : monto * 0.02;
        if (comision >= 14) {
          const recibir = monto - comision;
          const fullAmount = recibir.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
          });
          alert(`Monto total a recibir (descontando comisión):\nS/ ${fullAmount}`);
        }
      }
    });

    btnSolicitar.addEventListener('click', () => {
      if (btnSolicitar.disabled) return;
      
      alert('Serás redirigido a la página de inicio de sesión para continuar.');
      window.location.href = '/login';
    });
  };

  // Ejecutar inmediatamente. En Astro, los <script> (type="module") se ejecutan diferidos 
  // cuando el DOM ya está listo, así que DOMContentLoaded no siempre se dispara.
  initSimulador();
</script>
