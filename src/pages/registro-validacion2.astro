---
import Layout from '../layouts/Layout.astro';
import '../styles/registro-validacion.css';
---

<Layout title="Confirmación de Identidad | Capital Fest">
  <section class="register-section">
    <div class="register-container">
      <div class="register-grid">
        
        <!-- Columna Izquierda: Información de marca y Tarjeta 3D -->
        <div class="register-info-side">
          <h1 class="register-title animate-on-load">
            Tu dinero,<br />
            cuando más lo<br />
            <span class="text-gradient">necesites.</span>
          </h1>
          <p class="register-description animate-on-load delay-1">
            Convierte el saldo de tu tarjeta de crédito en efectivo al instante, de forma segura y sin vueltas.
          </p>

          <!-- Composición Visual -->
          <div class="register-visual animate-on-load delay-2">
            <img src="/assets/TARJETA-INICIO-SESION.webp" alt="Tarjeta Capital Fest Validación" class="register-visual-img" />
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Registro con Formulario en Grid -->
        <div class="register-form-side">
          <div class="register-card animate-on-load delay-3">
            
            <!-- Encabezado de la Tarjeta -->
            <div class="register-card-header">
              <h2>Confirmación de identidad financiera</h2>
            </div>

            <!-- Stepper de 3 Pasos -->
            <div class="register-stepper">
              <!-- Paso 01: Información (Completado/Activo) -->
              <div class="step-item">
                <div class="step-circle active">01</div>
                <span class="step-label active">Información</span>
              </div>
              
              <div class="step-divider"></div>
              
              <!-- Paso 02: Validación (Activo) -->
              <div class="step-item">
                <div class="step-circle active">02</div>
                <span class="step-label active">Validación</span>
              </div>
              
              <div class="step-divider"></div>
              
              <!-- Paso 03: Confirmación (Activo) -->
              <div class="step-item">
                <div class="step-circle active">03</div>
                <span class="step-label active">Confirmación</span>
              </div>
            </div>

            <!-- Formulario de Confirmación -->
            <form id="confirmacionForm" class="register-form-grid">
              
              <!-- Identidad financiera -->
              <div class="form-group">
                <label for="identidad" class="form-label">Identidad financiera</label>
                <div class="form-input-wrapper">
                  <select id="identidad" name="identidad" class="form-input" required>
                    <option value="" disabled selected>Seleccione su identidad financiera</option>
                    <option value="bcp">BCP</option>
                    <option value="interbank">Interbank</option>
                    <option value="bbva">BBVA</option>
                    <option value="scotiabank">Scotiabank</option>
                  </select>
                </div>
              </div>

              <!-- Nombre del titular -->
              <div class="form-group">
                <label for="titular" class="form-label">Nombre del titular</label>
                <div class="form-input-wrapper">
                  <input 
                    type="text" 
                    id="titular" 
                    name="titular" 
                    class="form-input" 
                    placeholder="Ingresar Nombres y apellidos" 
                    required 
                  />
                </div>
              </div>

              <!-- Cuenta bancaria -->
              <div class="form-group">
                <label for="cuenta" class="form-label">Cuenta bancaria</label>
                <div class="form-input-wrapper">
                  <input 
                    type="text" 
                    id="cuenta" 
                    name="cuenta" 
                    class="form-input" 
                    placeholder="Ingresar su nmro de cuenta bancaria" 
                    required 
                  />
                </div>
              </div>

              <!-- Botones -->
              <div class="btn-group-vertical" style="align-items: center; gap: 24px; margin-top: 10px;">
                <button type="button" class="validation-btn-outline-pill">
                  Añadir otra cuenta bancaria
                </button>
                <div class="btn-submit-container" style="display: flex; gap: 15px; width: 100%;">
                  <button type="button" class="btn-submit" onclick="window.location.href='/registro-validacion'" style="flex: 0.4; background: transparent; border: 1px solid rgba(255,255,255,0.3); box-shadow: none;">
                    Volver
                  </button>
                  <button type="submit" class="btn-submit" style="flex: 1;">
                    Confirmar datos
                  </button>
                </div>
              </div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const confirmacionForm = document.getElementById('confirmacionForm') as HTMLFormElement;
    const btnSubmit = confirmacionForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    // Restaurar datos guardados
    const savedAccountData = localStorage.getItem('capitalFest_validation2');
    if (savedAccountData) {
      try {
        const parsed = JSON.parse(savedAccountData);
        if (parsed.identidad) (document.getElementById('identidad') as HTMLSelectElement).value = parsed.identidad;
        if (parsed.titular) (document.getElementById('titular') as HTMLInputElement).value = parsed.titular;
        if (parsed.cuenta) (document.getElementById('cuenta') as HTMLInputElement).value = parsed.cuenta;
      } catch(e) {}
    }

    // Botón Volver (el primero del btn-submit-container)
    const btnVolver = confirmacionForm.querySelector('button[onclick="window.location.href=\'/registro-validacion\'"]') as HTMLButtonElement;
    if (btnVolver) {
      btnVolver.addEventListener('click', (e) => {
        e.preventDefault();
        const identidad = (document.getElementById('identidad') as HTMLSelectElement).value;
        const titular = (document.getElementById('titular') as HTMLInputElement).value;
        const cuenta = (document.getElementById('cuenta') as HTMLInputElement).value;
        localStorage.setItem('capitalFest_validation2', JSON.stringify({ identidad, titular, cuenta }));
        window.location.href = '/registro-validacion';
      });
      // Eliminar el onclick en línea para que se encargue el event listener
      btnVolver.removeAttribute('onclick');
    }

    confirmacionForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const identidad = (document.getElementById('identidad') as HTMLSelectElement).value;
      const titular = (document.getElementById('titular') as HTMLInputElement).value;
      const cuenta = (document.getElementById('cuenta') as HTMLInputElement).value;
      
      // Guardar datos al avanzar
      localStorage.setItem('capitalFest_validation2', JSON.stringify({ identidad, titular, cuenta }));
      
      const payloadStr = localStorage.getItem('capitalFest_registerPayload');
      if (!payloadStr) {
        alert('No se encontraron datos de registro. Por favor vuelve a intentarlo.');
        window.location.href = '/cuenta';
        return;
      }

      try {
        btnSubmit.textContent = 'Procesando...';
        btnSubmit.disabled = true;

        const payload = JSON.parse(payloadStr);
        const formData = new FormData(confirmacionForm);

        // Mapeo básico de banco a ID
        let bankId = 1;
        const identidad = formData.get('identidad');
        if (identidad === 'bcp') bankId = 1;
        if (identidad === 'interbank') bankId = 2;
        if (identidad === 'bbva') bankId = 3;
        if (identidad === 'scotiabank') bankId = 4;

        payload.bankAccounts = [{
          bankId: bankId,
          accountHolderName: formData.get('titular') as string,
          accountNumber: formData.get('cuenta') as string
        }];

        const res = await fetch('http://localhost:4000/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok) {
          // Guardar token y usuario para que quede logueado
          localStorage.setItem('capitalFest_token', data.token);
          if (data.user) {
            localStorage.setItem('capitalFest_user', JSON.stringify(data.user));
          }

          // Guardar el nombre para el paso 3
          localStorage.setItem('capitalFest_userName', JSON.stringify({
            firstName: payload.firstName,
            lastName: payload.lastName
          }));
          
          // Limpiar el payload temporal
          localStorage.removeItem('capitalFest_registerPayload');
          
          // Redirigir a la ultima pagina (manteniendo parámetros de búsqueda)
          const qs = window.location.search;
          const separator = qs ? '&' : '?';
          window.location.href = '/registro-validacion3' + qs + separator + 'success=1';
        } else {
          alert('Error al registrar: ' + (data.message || 'Intente nuevamente'));
          btnSubmit.textContent = 'Confirmar datos';
          btnSubmit.disabled = false;
        }
      } catch (error) {
        console.error(error);
        alert('Error de conexión con el servidor.');
        btnSubmit.textContent = 'Confirmar datos';
        btnSubmit.disabled = false;
      }
    });
  });
</script>
