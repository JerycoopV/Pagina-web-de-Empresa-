---
import Layout from '../layouts/Layout.astro';
import '../styles/cuenta.css';
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

<Layout title="Crear Cuenta | Capital Fest">
  <section class="register-section">
    <div class="register-container">
      <div class="register-grid">
        
        <!-- Columna Izquierda: Información de marca y Tarjeta 3D -->
        <div class="register-info-side">
          <h1 class="register-title animate-on-load">
            Tu dinero,<br />
            cuando más lo<br />
            <span class="text-gradient">necesites.</span>
          </h1>
          <p class="register-description animate-on-load delay-1">
            Convierte el saldo de tu tarjeta de crédito en efectivo al instante, de forma segura y sin vueltas.
          </p>

          <!-- Composición Visual (Misma que Login, Tamaño Grande) -->
          <div class="register-visual animate-on-load delay-2">
            <img src="/assets/TARJETA-INICIO-SESION.webp" alt="Tarjeta Capital Fest Crear Cuenta" class="register-visual-img" />
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Registro con Formulario en Grid -->
        <div class="register-form-side">
          <div class="register-card animate-on-load delay-3">
            
            <!-- Encabezado de la Tarjeta (Título + Enlace Iniciar Sesión) -->
            <div class="register-card-header">
              <h2>Crear cuenta</h2>
              <div class="login-redirect">
                <span class="redirect-text">¿Ya tienes cuenta?</span>
                <a href="/login" class="redirect-link" id="register-login-link">Iniciar Sesión</a>
              </div>
            </div>

            <!-- Stepper de 3 Pasos -->
            <div class="register-stepper">
              <!-- Paso 01: Información (Activo) -->
              <div class="step-item">
                <div class="step-circle active">01</div>
                <span class="step-label active">Información</span>
              </div>
              
              <div class="step-divider"></div>
              
              <!-- Paso 02: Validación (Inactivo) -->
              <div class="step-item">
                <div class="step-circle inactive">02</div>
                <span class="step-label inactive">Validación</span>
              </div>
              
              <div class="step-divider"></div>
              
              <!-- Paso 03: Confirmación (Inactivo) -->
              <div class="step-item">
                <div class="step-circle inactive">03</div>
                <span class="step-label inactive">Confirmación</span>
              </div>
            </div>

            <!-- Formulario en Grid -->
            <form id="registerForm" class="register-form-grid">
              
              <!-- PASO 1: INFORMACIÓN -->
              <div id="step-1" class="form-step active" style="display: contents;">
                <!-- Nombres -->
                <div class="form-group">
                  <label for="nombres" class="form-label">Nombres</label>
                  <div class="form-input-wrapper">
                    <input type="text" id="nombres" name="firstName" class="form-input" placeholder="Ingresa tus nombres" required autocomplete="given-name" />
                  </div>
                </div>

                <!-- Apellido -->
                <div class="form-group">
                  <label for="apellido" class="form-label">Apellido</label>
                  <div class="form-input-wrapper">
                    <input type="text" id="apellido" name="lastName" class="form-input" placeholder="Ingresa tus apellidos" required autocomplete="family-name" />
                  </div>
                </div>

                <!-- Fecha de Nacimiento -->
                <div class="form-group">
                  <label for="nacimiento" class="form-label">Fecha de Nacimiento</label>
                  <div class="form-input-wrapper">
                    <input type="text" id="nacimiento" name="birthDate" class="form-input" placeholder="Selecciona tu fecha" required />
                  </div>
                </div>

                <!-- Teléfono -->
                <div class="form-group">
                  <label for="telefono" class="form-label">Teléfono</label>
                  <div class="form-input-wrapper">
                    <input type="tel" id="telefono" name="phone" class="form-input" placeholder="+51 999 999 999" required autocomplete="tel" />
                  </div>
                </div>

                <!-- Correo electrónico -->
                <div class="form-group">
                  <label for="email" class="form-label">Correo electrónico</label>
                  <div class="form-input-wrapper">
                    <input type="email" id="email" name="email" class="form-input" placeholder="ejemplo28@correo.com" required autocomplete="email" />
                  </div>
                </div>

                <!-- Confirmar correo electrónico -->
                <div class="form-group">
                  <label for="email-confirm" class="form-label">Confirmar correo electrónico</label>
                  <div class="form-input-wrapper">
                    <input type="email" id="email-confirm" class="form-input" placeholder="ejemplo28@correo.com" required autocomplete="email" />
                  </div>
                </div>

                <!-- Contraseña -->
                <div class="form-group">
                  <label for="password" class="form-label">Contraseña</label>
                  <div class="form-input-wrapper">
                    <input type="password" id="password" name="password" class="form-input" placeholder="Crear una contraseña" required autocomplete="new-password" />
                  </div>
                </div>

                <!-- Confirmar contraseña -->
                <div class="form-group">
                  <label for="password-confirm" class="form-label">Confirmar contraseña</label>
                  <div class="form-input-wrapper">
                    <input type="password" id="password-confirm" class="form-input" placeholder="Confirma tu contraseña" required autocomplete="new-password" />
                  </div>
                </div>

                <!-- Barra de seguridad de la contraseña -->
                <div class="password-strength-container" style="grid-column: 1 / -1;">
                  <span class="strength-label">Seguridad de contraseña</span>
                  <div class="strength-bars">
                    <div class="strength-bar active"></div>
                    <div class="strength-bar active"></div>
                    <div class="strength-bar"></div>
                    <div class="strength-bar"></div>
                    <div class="strength-bar"></div>
                  </div>
                </div>

                <!-- Botón Siguiente -->
                <div class="btn-submit-container" style="grid-column: 1 / -1;">
                  <button type="button" class="btn-submit" id="btn-next-step">
                    Siguiente
                  </button>
                </div>
              </div>

              <!-- PASO 2: VALIDACIÓN -->
              <div id="step-2" class="form-step hidden" style="display: none;">
                <!-- Nombres (Confirmación) -->
                <div class="form-group">
                  <label for="nombres-conf" class="form-label">Nombres</label>
                  <div class="form-input-wrapper">
                    <input type="text" id="nombres-conf" class="form-input" placeholder="Ingresa tus nombres" required readonly style="background-color: rgba(255, 255, 255, 0.1); cursor: not-allowed;" />
                  </div>
                </div>

                <!-- Apellido (Confirmación) -->
                <div class="form-group">
                  <label for="apellido-conf" class="form-label">Apellido</label>
                  <div class="form-input-wrapper">
                    <input type="text" id="apellido-conf" class="form-input" placeholder="Ingresa tus apellidos" required readonly style="background-color: rgba(255, 255, 255, 0.1); cursor: not-allowed;" />
                  </div>
                </div>

                <!-- Tipo de Documento -->
                <div class="form-group">
                  <label for="documentTypeId" class="form-label">Tipo de Documento</label>
                  <div class="form-input-wrapper">
                    <select id="documentTypeId" name="documentTypeId" class="form-input" required>
                      <option value="" disabled selected>Selecciona tu documento</option>
                      <option value="1">DNI</option>
                      <option value="2">CE</option>
                      <option value="3">Pasaporte</option>
                    </select>
                  </div>
                </div>

                <!-- Nmro de documento -->
                <div class="form-group">
                  <label for="documentNumber" class="form-label">Nmro de documento</label>
                  <div class="form-input-wrapper">
                    <input type="text" id="documentNumber" name="documentNumber" class="form-input" placeholder="Ingresa tu documento" required />
                  </div>
                </div>

                <!-- Departamento -->
                <div class="form-group">
                  <label for="departmentId" class="form-label">Departamento</label>
                  <div class="form-input-wrapper">
                    <select id="departmentId" name="departmentId" class="form-input" required>
                      <option value="" disabled selected>Selecciona tu departamento</option>
                      <option value="15">Lima</option>
                      <option value="4">Arequipa</option>
                    </select>
                  </div>
                </div>

                <!-- Provincia -->
                <div class="form-group">
                  <label for="provinceId" class="form-label">Provincia</label>
                  <div class="form-input-wrapper">
                    <select id="provinceId" name="provinceId" class="form-input" required>
                      <option value="" disabled selected>Selecciona tu provincia</option>
                      <option value="1501">Lima</option>
                    </select>
                  </div>
                </div>

                <!-- Distrito -->
                <div class="form-group">
                  <label for="districtId" class="form-label">Distrito</label>
                  <div class="form-input-wrapper">
                    <select id="districtId" name="districtId" class="form-input" required>
                      <option value="" disabled selected>Selecciona tu distrito</option>
                      <option value="150101">Lima (Cercado)</option>
                    </select>
                  </div>
                </div>

                <!-- Dirección -->
                <div class="form-group">
                  <label for="address" class="form-label">Dirección</label>
                  <div class="form-input-wrapper">
                    <input type="text" id="address" name="address" class="form-input" placeholder="Inrese su dirección" required />
                  </div>
                </div>

                <!-- Botones Paso 2 -->
                <div class="btn-submit-container" style="grid-column: 1 / -1; margin-top: 10px; display: flex; gap: 15px;">
                  <button type="button" class="btn-submit" id="btn-back-step-1" style="flex: 0.4; background: transparent; border: 1px solid rgba(255,255,255,0.3); box-shadow: none;">
                    Volver
                  </button>
                  <button type="button" class="btn-submit" id="btn-next-step-2" style="flex: 1;">
                    Confirmar Datos
                  </button>
                </div>
              </div>

              <!-- PASO 3: FOTOS DE DOCUMENTO -->
              <div id="step-3" class="form-step hidden" style="display: none; grid-column: 1 / -1;">
                <div style="grid-column: 1 / -1; margin-bottom: 20px; text-align: center;">
                  <h3 style="color: white; font-size: 1.5rem; font-weight: bold;">Validación de documento de identidad</h3>
                </div>
                
                <div class="form-group" style="grid-column: 1 / -1; margin-bottom: 20px;">
                  <label class="form-label" style="text-align: center; display: block; font-size: 1.1rem; margin-bottom: 15px;">Adjuntar foto frontal del <span class="doc-type-label">DNI</span></label>
                  <label class="file-upload-box" style="display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, rgba(30, 20, 60, 0.6) 0%, rgba(15, 10, 30, 0.8) 100%); border: 1px solid rgba(138, 43, 226, 0.2); border-radius: 12px; height: 80px; cursor: pointer; color: white; font-size: 2.5rem; transition: 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                    +
                    <input type="file" id="documentFront" name="documentFront" accept="image/*" style="display: none;" />
                  </label>
                </div>

                <div class="form-group" style="grid-column: 1 / -1; margin-bottom: 20px;">
                  <label class="form-label" style="text-align: center; display: block; font-size: 1.1rem; margin-bottom: 15px;">Adjuntar foto trasera del <span class="doc-type-label">DNI</span></label>
                  <label class="file-upload-box" style="display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, rgba(30, 20, 60, 0.6) 0%, rgba(15, 10, 30, 0.8) 100%); border: 1px solid rgba(138, 43, 226, 0.2); border-radius: 12px; height: 80px; cursor: pointer; color: white; font-size: 2.5rem; transition: 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                    +
                    <input type="file" id="documentBack" name="documentBack" accept="image/*" style="display: none;" />
                  </label>
                </div>

                <div class="form-group" style="grid-column: 1 / -1; margin-bottom: 30px;">
                  <label class="form-label" style="text-align: center; display: block; font-size: 1.1rem; margin-bottom: 15px;">Adjuntar foto de perfil con el <span class="doc-type-label">DNI</span></label>
                  <label class="file-upload-box" style="display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, rgba(30, 20, 60, 0.6) 0%, rgba(15, 10, 30, 0.8) 100%); border: 1px solid rgba(138, 43, 226, 0.2); border-radius: 12px; height: 80px; cursor: pointer; color: white; font-size: 2.5rem; transition: 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                    +
                    <input type="file" id="selfie" name="selfie" accept="image/*" style="display: none;" />
                  </label>
                </div>

                <!-- Botones Paso 3 (Submit Final) -->
                <div class="btn-submit-container" style="grid-column: 1 / -1; display: flex; gap: 15px;">
                  <button type="button" class="btn-submit" id="btn-back-step-2" style="flex: 0.4; background: transparent; border: 1px solid rgba(255,255,255,0.3); box-shadow: none;">
                    Volver
                  </button>
                  <button type="submit" class="btn-submit" id="register-btn-submit" style="flex: 1;">
                    Siguiente
                  </button>
                </div>
              </div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const registerForm = document.getElementById('registerForm') as HTMLFormElement;
    const btnNextStep = document.getElementById('btn-next-step') as HTMLButtonElement;
    const btnNextStep2 = document.getElementById('btn-next-step-2') as HTMLButtonElement;
    const btnSubmit = document.getElementById('register-btn-submit') as HTMLButtonElement;
    
    const step1 = document.getElementById('step-1') as HTMLDivElement;
    const step2 = document.getElementById('step-2') as HTMLDivElement;
    const step3 = document.getElementById('step-3') as HTMLDivElement;
    
    // Inicializar el calendario Flatpickr para la fecha de nacimiento
    // @ts-ignore
    flatpickr("#nacimiento", {
      locale: "es",
      dateFormat: "Y-m-d",
      altInput: true,
      altFormat: "d/m/Y",
      maxDate: "today",
      disableMobile: "true" // Fuerza a usar este calendario en moviles también en lugar del nativo
    });
    
    // Elementos visuales del Stepper
    const stepCircles = document.querySelectorAll('.step-circle');
    const stepLabels = document.querySelectorAll('.step-label');

    btnNextStep.addEventListener('click', () => {
      // Basic validation for Step 1
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const emailConfirm = (document.getElementById('email-confirm') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const passwordConfirm = (document.getElementById('password-confirm') as HTMLInputElement).value;

      // Validate only visible inputs in Step 1 to avoid "not focusable" errors on hidden Step 2 inputs
      const step1Inputs = step1.querySelectorAll('input[required]');
      for (const input of Array.from(step1Inputs)) {
        const inputElement = input as HTMLInputElement;
        if (!inputElement.checkValidity()) {
          inputElement.reportValidity();
          return;
        }
      }

      if (email !== emailConfirm) {
        alert('Los correos electrónicos no coinciden.');
        return;
      }

      if (password !== passwordConfirm) {
        alert('Las contraseñas no coinciden.');
        return;
      }

      // Autofill step 2 name fields
      const firstNameInput = document.getElementById('nombres') as HTMLInputElement;
      const lastNameInput = document.getElementById('apellido') as HTMLInputElement;
      (document.getElementById('nombres-conf') as HTMLInputElement).value = firstNameInput.value;
      (document.getElementById('apellido-conf') as HTMLInputElement).value = lastNameInput.value;

      // Hide Step 1, Show Step 2
      step1.style.display = 'none';
      step2.style.display = 'contents'; // using contents to maintain grid layout

      // Update Visual Stepper
      if(stepCircles.length > 1 && stepLabels.length > 1) {
        stepCircles[1].classList.remove('inactive');
        stepCircles[1].classList.add('active');
        stepLabels[1].classList.remove('inactive');
        stepLabels[1].classList.add('active');
      }
    });

    btnNextStep2.addEventListener('click', () => {
      // Validate only visible inputs in Step 2 to avoid "not focusable" errors on hidden Step 3 inputs
      const step2Inputs = step2.querySelectorAll('input[required], select[required]');
      for (const input of Array.from(step2Inputs)) {
        const inputElement = input as HTMLInputElement | HTMLSelectElement;
        if (!inputElement.checkValidity()) {
          inputElement.reportValidity();
          return;
        }
      }

      const firstName = (document.getElementById('nombres') as HTMLInputElement).value;
      const lastName = (document.getElementById('apellido') as HTMLInputElement).value;
      const firstNameConf = (document.getElementById('nombres-conf') as HTMLInputElement).value;
      const lastNameConf = (document.getElementById('apellido-conf') as HTMLInputElement).value;

      // Update document type labels in Step 3 dynamically
      const docSelect = document.getElementById('documentTypeId') as HTMLSelectElement;
      const docTypeName = docSelect.options[docSelect.selectedIndex].text;
      document.querySelectorAll('.doc-type-label').forEach(el => {
        el.textContent = docTypeName;
      });

      // Hide Step 2, Show Step 3
      step2.style.display = 'none';
      step3.style.display = 'contents';

      // Update Visual Stepper
      if(stepCircles.length > 2 && stepLabels.length > 2) {
        stepCircles[2].classList.remove('inactive');
        stepCircles[2].classList.add('active');
        stepLabels[2].classList.remove('inactive');
        stepLabels[2].classList.add('active');
      }
    });

    // Fix file UI change
    document.querySelectorAll('input[type="file"]').forEach(input => {
      input.addEventListener('change', function(this: HTMLInputElement) {
        if (this.files && this.files.length > 0) {
          const parent = this.parentElement;
          if (parent) {
            parent.style.background = 'rgba(138, 43, 226, 0.4)';
            // Delete the text node "+"
            Array.from(parent.childNodes).forEach(node => {
              if (node.nodeType === Node.TEXT_NODE) node.textContent = '✓ ';
            });
          }
        }
      });
    });

    // Back buttons logic
    const btnBackStep1 = document.getElementById('btn-back-step-1') as HTMLButtonElement;
    const btnBackStep2 = document.getElementById('btn-back-step-2') as HTMLButtonElement;

    if (btnBackStep1) {
      btnBackStep1.addEventListener('click', () => {
        step2.style.display = 'none';
        step1.style.display = 'contents';
        if(stepCircles.length > 1 && stepLabels.length > 1) {
          stepCircles[1].classList.remove('active');
          stepCircles[1].classList.add('inactive');
          stepLabels[1].classList.remove('active');
          stepLabels[1].classList.add('inactive');
        }
      });
    }

    if (btnBackStep2) {
      btnBackStep2.addEventListener('click', () => {
        step3.style.display = 'none';
        step2.style.display = 'contents';
        if(stepCircles.length > 2 && stepLabels.length > 2) {
          stepCircles[2].classList.remove('active');
          stepCircles[2].classList.add('inactive');
          stepLabels[2].classList.remove('active');
          stepLabels[2].classList.add('inactive');
        }
      });
    }

    registerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(registerForm);
      const firstName = formData.get('firstName') as string;
      const lastName = formData.get('lastName') as string;

      // Construir payload
      const payload = {
        firstName,
        lastName,
        email: formData.get('email'),
        password: formData.get('password'),
        birthDate: new Date(formData.get('birthDate') as string).toISOString(),
        phone: formData.get('phone'),
        documentTypeId: Number(formData.get('documentTypeId')),
        documentNumber: formData.get('documentNumber'),
        departmentId: Number(formData.get('departmentId')),
        provinceId: Number(formData.get('provinceId')),
        districtId: Number(formData.get('districtId')),
        address: formData.get('address')
      };

      try {
        btnSubmit.textContent = 'Procesando...';
        btnSubmit.disabled = true;

        const res = await fetch('http://localhost:4000/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok) {
          alert('Cuenta creada exitosamente. ¡Bienvenido!');
          window.location.href = '/login';
        } else {
          alert('Error al registrar: ' + (data.message || 'Intente nuevamente'));
          btnSubmit.textContent = 'Confirmar Datos';
          btnSubmit.disabled = false;
        }
      } catch (error) {
        console.error(error);
        alert('Error de conexión con el servidor.');
        btnSubmit.textContent = 'Confirmar Datos';
        btnSubmit.disabled = false;
      }
    });
  });
</script>
