---
import Layout from '../layouts/Layout.astro';
import '../styles/login.css';
---

<Layout title="Iniciar Sesión | Capital Fest">
  <section class="login-section">
    <div class="login-container">
      <div class="login-grid">
        
        <!-- Columna Izquierda: Información de la marca y Tarjeta 3D -->
        <div class="login-info-side">
          <h1 class="login-title animate-on-load">
            Tu dinero,<br />
            cuando más lo<br />
            <span class="text-gradient">necesites.</span>
          </h1>

          <!-- Grid de 3 Características -->
          <div class="login-features animate-on-load delay-1">
            <!-- 100% Seguro -->
            <div class="login-feature-item">
              <div class="login-feature-icon">
                <svg viewBox="0 0 34.96 39.88" fill="currentColor">
                  <path d="m26.34,15.88c.02.61-.22,1.11-.64,1.53-2.75,2.76-5.49,5.51-8.24,8.26-.92.92-2.14.9-3.08-.02-1.35-1.34-2.69-2.68-4.02-4.04-.88-.89-.9-2.17-.07-3.01.81-.82,2.12-.81,3,.05.78.76,1.55,1.52,2.29,2.3.28.29.42.28.7,0,2.13-2.16,4.28-4.31,6.43-6.45,1.19-1.18,2.99-.79,3.53.74.07.21.09.42.09.63Z"/>
                  <path d="m34.79,15.21c1.25,11.22-4.48,19.09-15.05,24.07-1.66.78-3.13.81-4.78-.02C5.36,34.41-.59,27.29.05,15.89c.15-2.76.09-5.53,0-8.29-.06-1.69.59-2.51,2.26-2.82C7.07,3.89,11.74,2.67,16.04.32c1.05-.57,2.12-.29,3.12.23,4.07,2.13,8.44,3.37,12.92,4.17,2.11.38,2.82,1.4,2.73,3.41-.09,2.07-.02,4.15-.02,7.08Zm-4.26,1.1q.03-7.17-5.82-9.06c-.38-.12-.77-.22-1.11-.41-4.04-2.34-8.04-2.54-12.14-.04-2.16,1.31-5.76.48-6.86,2.6-1.05,2.04-.22,5.02-.3,7.59-.27,8.54,4.05,14.11,11.33,17.89,1.42.74,2.51.59,3.84-.12,7.85-4.18,11.99-10.41,11.05-18.44Z"/>
                </svg>
              </div>
              <div class="login-feature-text">
                <h3>100% Seguro</h3>
                <p>Protegemos tus datos en cada operación.</p>
              </div>
            </div>

            <!-- Al instante -->
            <div class="login-feature-item">
              <div class="login-feature-icon">
                <svg viewBox="0 0 27.53 40.71" fill="currentColor">
                  <path d="m27.38,15.62c-.24-.47-.67-.73-1.2-.73-.09,0-.18,0-.27.02l-6.76.97c-.66.09-1.31.18-1.97.27l7.42-12.34c.35-.59.71-1.17,1.05-1.76.38-.64.27-1.32-.29-1.76-.25-.2-.53-.3-.81-.3-.33,0-.66.14-.96.41-.08.07-.16.15-.24.23L6.85,17.11c-2.11,2.1-4.21,4.21-6.33,6.31-.52.52-.65,1.06-.39,1.62.23.49.67.77,1.22.77.08,0,.16,0,.24-.02l8.76-1.25s-8,13.31-8.46,14.07c-.39.65-.3,1.31.24,1.76.26.22.55.33.84.33.35,0,.68-.15.98-.44.11-.1.22-.21.37-.37,0,0,20.05-20,22.61-22.56.24-.24.86-.86.43-1.72Zm-15.92,12.24c.8-1.34,1.6-2.67,2.42-4.01.26-.42.64-1.06.14-1.78-.26-.37-.63-.55-1.11-.55-.17,0-.35.02-.55.05l-6.98,1,12.13-12.1-.16.27c-1.23,2.05-2.46,4.09-3.69,6.14-.25.41-.62,1.02-.15,1.73.26.39.64.58,1.14.58.17,0,.35-.02.52-.05l6.93-1-11.95,11.91,1.32-2.2Z"/>
                </svg>
              </div>
              <div class="login-feature-text">
                <h3>Al instante</h3>
                <p>Recibe tu dinero en minutos.</p>
              </div>
            </div>

            <!-- Sin vueltas -->
            <div class="login-feature-item">
              <div class="login-feature-icon">
                <svg viewBox="0 0 39.91 40" fill="currentColor">
                  <path d="m0,19.99C0,8.94,8.97-.02,19.98,0c11.02.02,19.95,8.99,19.93,20.04-.02,11.04-8.99,19.99-20.01,19.96C8.91,39.98,0,31,0,19.99Zm4.42-.04c-.02,8.52,6.93,15.58,15.38,15.62,8.62.04,15.66-6.92,15.68-15.49.02-8.59-6.92-15.61-15.47-15.65-8.55-.03-15.57,6.95-15.6,15.52Z"/>
                  <path d="m28.81,15.54c.02.64-.23,1.18-.68,1.63-2.92,2.93-5.84,5.87-8.77,8.79-.98.98-2.28.96-3.27-.02-1.44-1.42-2.86-2.85-4.28-4.29-.93-.95-.96-2.31-.08-3.2.86-.88,2.26-.86,3.2.06.83.8,1.65,1.61,2.44,2.45.29.31.45.3.75,0,2.27-2.3,4.55-4.59,6.85-6.87,1.27-1.26,3.19-.84,3.76.79.08.22.09.44.1.67Z"/>
                </svg>
              </div>
              <div class="login-feature-text">
                <h3>Sin vueltas</h3>
                <p>Proceso simple, claro y sin complicaciones.</p>
              </div>
            </div>
          </div>

          <!-- Composición Visual -->
          <div class="login-visual animate-on-load delay-2">
            <img src="/assets/TARJETA-INICIO-SESION.webp" alt="Tarjeta Capital Fest Iniciar Sesión" class="login-visual-img" />
          </div>
        </div>

        <!-- Columna Derecha: Formulario de Login -->
        <div class="login-form-side">
          <div class="login-card animate-on-load delay-3">
            
            <!-- Encabezado de la Tarjeta -->
            <div class="login-card-header">
              <h2>Iniciar sesión</h2>
              <p>Bienvenido de vuelta a Capital Fest</p>
            </div>

            <!-- Formulario -->
            <form id="loginForm" class="login-form">
              
              <!-- Correo electrónico -->
              <div class="form-group">
                <label for="email" class="form-label">Correo electrónico:</label>
                <div class="form-input-wrapper">
                  <input 
                    type="email" 
                    id="email" 
                    name="email"
                    class="form-input" 
                    placeholder="ejemplo28@correo.com" 
                    required 
                    autocomplete="email"
                  />
                </div>
              </div>

              <!-- Contraseña -->
              <div class="form-group">
                <label for="password" class="form-label">Contraseña:</label>
                <div class="form-input-wrapper">
                  <input 
                    type="password" 
                    id="password" 
                    name="password"
                    class="form-input" 
                    placeholder="Ingresa tu contraseña" 
                    required 
                    autocomplete="current-password"
                  />
                </div>
              </div>

              <!-- Enlace de contraseña olvidada -->
              <a href="#" class="forgot-password-link" id="login-forgot-password">
                ¿Olvidaste tu contraseña?
              </a>

              <!-- Botón Ingresar -->
              <button type="submit" class="btn-submit" id="login-btn-submit">
                Ingresar
              </button>
            </form>

            <!-- Footer de la Tarjeta -->
            <div class="login-card-footer">
              <span class="login-footer-text">¿Aún no tienes cuenta?</span>
              <a href="/cuenta" class="register-link" id="login-register-link">
                Crear Cuenta
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const loginForm = document.getElementById('loginForm') as HTMLFormElement;
    const btnSubmit = document.getElementById('login-btn-submit') as HTMLButtonElement;

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(loginForm);
      const email = formData.get('email');
      const password = formData.get('password');

      try {
        btnSubmit.textContent = 'Verificando...';
        btnSubmit.disabled = true;

        const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/auth/login`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ email, password })
        });

        const data = await res.json();

        if (res.ok) {
          localStorage.setItem('capitalFest_token', data.token);
          localStorage.setItem('capitalFest_user', JSON.stringify(data.user));
          
          alert(`Bienvenido, ${data.user.firstName}!`);

          const params = new URLSearchParams(window.location.search);
          const redirect = params.get('redirect');
          const monto = params.get('monto');
          const role = data.user.role;
          const roleName = typeof role === 'string' ? role : role?.name;
          const isAdmin = [roleName, data.user.roleName, data.user.userRole].some(value => String(value || '').toLowerCase() === 'admin') || Number(data.user.roleId) === 2;
          
          if (isAdmin) {
            window.location.href = '/admin';
          } else if (redirect) {
            let redirectUrl = redirect;
            if (monto) {
              redirectUrl += `?monto=${monto}`;
            }
            window.location.href = redirectUrl;
          } else {
            window.location.href = '/dashboard'; 
          }
        } else {
          alert('Error de login: ' + (data.message || 'Credenciales inválidas'));
          btnSubmit.textContent = 'Ingresar';
          btnSubmit.disabled = false;
        }
      } catch (error) {
        console.error(error);
        alert('Hubo un problema contactando al servidor.');
        btnSubmit.textContent = 'Ingresar';
        btnSubmit.disabled = false;
      }
    });

    const registerLink = document.getElementById('login-register-link') as HTMLAnchorElement;
    if (registerLink && window.location.search) {
      registerLink.href = '/cuenta' + window.location.search;
    }
  });
</script>
