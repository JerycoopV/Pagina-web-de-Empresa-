---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import '../styles/index.css';
import '../styles/nosotros.css';
---

<Layout title="Beneficios | Capital Fest">
  <!-- Sección: Maximiza tus Beneficios -->
  <section class="benefits-section" id="maximiza-beneficios" style="margin-top: 40px;">
    <h2 class="benefits-section-title animate-on-scroll">
      Máximiza tus <span class="text-gradient">Beneficios</span>
    </h2>
    
    <!-- Fila Superior: 3 Cards -->
    <div class="benefits-row top-row stagger-container">
      <!-- Card 1: Rentabilidad -->
      <div class="benefit-row-card animate-on-scroll" id="card-rentabilidad">
        <div class="benefit-img-container">
          <img src="/assets/rentabilidad.webp" alt="Rentabilidad" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Rentabilidad</h3>
          <p>Maximice sus fondos de forma directa.</p>
        </div>
      </div>

      <!-- Card 2: Tasa Preferencial -->
      <div class="benefit-row-card animate-on-scroll" id="card-tasa-preferencial">
        <div class="benefit-img-container">
          <img src="/assets/tasa.webp" alt="Tasa Preferencial" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Tasa Preferencial</h3>
          <p>Solicite condiciones preferenciales vía WhatsApp.</p>
        </div>
      </div>

      <!-- Card 3: Beneficios -->
      <div class="benefit-row-card animate-on-scroll" id="card-beneficios-fest">
        <div class="benefit-img-container">
          <img src="/assets/beneficios.webp" alt="Beneficios" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Beneficios</h3>
          <p>Descuentos y accesos exclusivos en Capital Fest.</p>
        </div>
      </div>
    </div>

    <!-- Fila Inferior: 2 Cards -->
    <div class="benefits-row bottom-row stagger-container">
      <!-- Card 4: Red de Contactos -->
      <div class="benefit-row-card animate-on-scroll" id="card-red-contactos">
        <div class="benefit-img-container">
          <img src="/assets/red.webp" alt="Red de Contactos" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Red de Contactos</h3>
          <p>Conexión directa con nuestra comunidad ejecutiva.</p>
        </div>
      </div>

      <!-- Card 5: Soporte Continuo -->
      <div class="benefit-row-card animate-on-scroll" id="card-soporte-continuo">
        <div class="benefit-img-container">
          <img src="/assets/soporte.webp" alt="Soporte Continuo" class="benefit-img" />
        </div>
        <div class="benefit-info">
          <h3>Soporte Continuo</h3>
          <p>Atención y respaldo institucional 24/7.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección Bancos Afiliados -->
  <div class="nosotros-bancos-section animate-on-scroll" style="margin-top: 80px;">
    <h2 class="nosotros-bancos-title">Bancos <span class="text-gradient nosotros-bancos-title-span">Afiliados</span></h2>
    <div class="nosotros-bancos-card">
      <div class="bancos-grid-row row-1">
        <img src="/assets/banco4.webp" alt="Scotiabank" class="nosotros-banco-logo" style="height: 68px; max-width: 260px;" />
        <img src="/assets/banco1.webp" alt="BanBif" class="nosotros-banco-logo" />
        <img src="/assets/banco5.webp" alt="Interbank" class="nosotros-banco-logo" style="height: 68px; max-width: 260px;" />
      </div>
      <div class="bancos-grid-row row-2">
        <img src="/assets/banco2.webp" alt="BBVA" class="nosotros-banco-logo" />
        <img src="/assets/banco3.webp" alt="BCP" class="nosotros-banco-logo" />
      </div>
    </div>
  </div>

  <!-- Sección: Banner de Llamado a la Acción (CTA) -->
  <section class="cta-banner-section animate-on-scroll" id="cta-banner" style="margin-top: 80px;">
    <div class="cta-card">
      <span class="badge">RÁPIDO, SEGURO Y CONFIABLE</span>
      
      <h2 class="cta-title">
        Obtén efectivo en <span class="text-gradient">minutos.</span>
      </h2>
      
      <p class="cta-description">
        Convierte el saldo de tu tarjeta de crédito al instante, de forma segura y sin problemas.
      </p>

      <div class="cta-actions">
        <a href="/simulador" class="btn btn-hero-gradient" id="cta-btn-simular">
          Simular retiro
        </a>
        <a href="/#como-funciona" class="btn-cta-outline" id="cta-btn-como-funciona">
          Cómo funciona
        </a>
      </div>

      <div class="cta-footer-text">
        100% Seguro • Sin complicaciones • Respuesta inmediata
      </div>
    </div>
  </section>

  <!-- Script de Intersección para Animaciones de Scroll Premium -->
  <script>
    // Configuración del Observador de Intersección
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -80px 0px', // Activa la animación un poco antes de que entre del todo en pantalla
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target); // Solo animar una vez al entrar
        }
      });
    }, observerOptions);

    // Observar todos los elementos designados para animarse al deslizar
    const scrollElements = document.querySelectorAll('.animate-on-scroll');
    scrollElements.forEach(el => observer.observe(el));
  </script>
</Layout>
