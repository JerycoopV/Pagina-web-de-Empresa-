---
import Layout from '../layouts/Layout.astro';
import '../styles/registro-validacion.css';
import tarjetaFrontal from '../assets/TARJETA-FRONTAL-REFERENCIA.png';
---

<Layout title="Validación Bancaria | Capital Fest">
  <section class="register-section">
    <div class="register-container">
      <div class="register-grid">
        
        <!-- Columna Izquierda: Información de marca y Tarjeta 3D -->
        <div class="register-info-side">
          <h1 class="register-title animate-on-load">
            Tu dinero,<br />
            cuando más lo<br />
            <span class="text-gradient">necesites.</span>
          </h1>
          <p class="register-description animate-on-load delay-1">
            Convierte el saldo de tu tarjeta de crédito en efectivo al instante, de forma segura y sin vueltas.
          </p>

          <!-- Composición Visual -->
          <div class="register-visual animate-on-load delay-2">
            <img src="/assets/TARJETA-INICIO-SESION.webp" alt="Tarjeta Capital Fest Validación" class="register-visual-img" />
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Registro con Formulario en Grid -->
        <div class="register-form-side">
          <div class="register-card animate-on-load delay-3">
            
            <!-- Encabezado de la Tarjeta -->
            <div class="register-card-header">
              <h2>Validación bancaria</h2>
            </div>

            <!-- Stepper de 3 Pasos -->
            <div class="register-stepper">
              <!-- Paso 01: Información (Completado/Activo) -->
              <div class="step-item">
                <div class="step-circle active">01</div>
                <span class="step-label active">Información</span>
              </div>
              
              <div class="step-divider"></div>
              
              <!-- Paso 02: Validación (Activo) -->
              <div class="step-item">
                <div class="step-circle active">02</div>
                <span class="step-label active">Validación</span>
              </div>
              
              <div class="step-divider"></div>
              
              <!-- Paso 03: Confirmación (Inactivo) -->
              <div class="step-item">
                <div class="step-circle inactive">03</div>
                <span class="step-label inactive">Confirmación</span>
              </div>
            </div>

            <!-- Formulario de Validación Bancaria -->
            <form id="validacionForm" class="register-form-grid">
              
              <!-- Identidad financiera -->
              <div class="form-group">
                <label for="identidad" class="form-label">Identidad financiera</label>
                <div class="form-input-wrapper">
                  <select id="identidad" name="identidad" class="form-input" required>
                    <option value="" disabled selected>Seleccione su identidad financiera</option>
                    <option value="bcp">BCP</option>
                    <option value="interbank">Interbank</option>
                    <option value="bbva">BBVA</option>
                    <option value="scotiabank">Scotiabank</option>
                  </select>
                </div>
              </div>

              <!-- Digitos bancarios -->
              <div class="form-group">
                <label for="digitos" class="form-label">Dígitos bancarios</label>
                <div class="form-input-wrapper">
                  <input 
                    type="text" 
                    id="digitos" 
                    name="digitos" 
                    class="form-input" 
                    placeholder="Ingresar 4 ultimos digitos de su tarjeta" 
                    maxlength="4" 
                    pattern="[0-9]{4}" 
                    title="Debe ingresar exactamente 4 números"
                    oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 4)"
                    required 
                  />
                </div>
              </div>

              <!-- Imagen de tarjeta frontal -->
              <div class="form-group" style="margin-top: 24px; display: flex; justify-content: center; align-items: center;">
                 <div style="width: 100%; max-width: 320px; padding: 12px; background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.01)); border-radius: 20px; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 0 0 1px rgba(255,255,255,0.05); backdrop-filter: blur(10px); transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 16px 40px rgba(138,43,226,0.25), inset 0 0 0 1px rgba(255,255,255,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 32px rgba(0,0,0,0.3), inset 0 0 0 1px rgba(255,255,255,0.05)';">
                    <img src={tarjetaFrontal.src} alt="Tarjeta Frontal" style="width: 100%; height: auto; border-radius: 12px; object-fit: contain; display: block; box-shadow: 0 4px 15px rgba(0,0,0,0.2);" />
                 </div>
              </div>

              <!-- Botones -->
              <div class="btn-group-vertical">
                <div class="btn-submit-container" style="display: flex; gap: 15px; width: 100%; margin-top: 20px;">
                  <button type="button" class="btn-submit" id="btn-volver-val1" style="flex: 0.4; background: transparent; border: 1px solid rgba(255,255,255,0.3); box-shadow: none;">
                    Volver
                  </button>
                  <button type="submit" class="btn-submit" style="flex: 1;">
                    Siguiente
                  </button>
                </div>
              </div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Cambio en UI para la selección de archivo (foto de tarjeta)
    const fileInputs = document.querySelectorAll('input[type="file"]');
    fileInputs.forEach(input => {
      input.addEventListener('change', function(this: HTMLInputElement) {
        if (this.files && this.files.length > 0) {
          const parent = this.parentElement;
          if (parent) {
            parent.style.background = 'rgba(138, 43, 226, 0.4)'; // Color morado cuando hay archivo
            // Reemplazar el "+" por un check
            Array.from(parent.childNodes).forEach(node => {
              if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim() === '+') {
                node.textContent = '✓ ';
              }
            });
          }
        }
      });
    });

    // Restaurar datos guardados
    const savedCardData = localStorage.getItem('capitalFest_validation1');
    if (savedCardData) {
      try {
        const parsed = JSON.parse(savedCardData);
        if (parsed.identidad) (document.getElementById('identidad') as HTMLSelectElement).value = parsed.identidad;
        if (parsed.digitos) (document.getElementById('digitos') as HTMLInputElement).value = parsed.digitos;
      } catch(e) {}
    }

    // Botón Volver
    const btnVolver = document.getElementById('btn-volver-val1');
    if (btnVolver) {
      btnVolver.addEventListener('click', () => {
        const identidad = (document.getElementById('identidad') as HTMLSelectElement).value;
        const digitos = (document.getElementById('digitos') as HTMLInputElement).value;
        localStorage.setItem('capitalFest_validation1', JSON.stringify({ identidad, digitos }));
        window.location.href = '/cuenta?return=true';
      });
    }

    // Envío del formulario
    const validacionForm = document.getElementById('validacionForm') as HTMLFormElement;
    validacionForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(validacionForm);
      const identidad = formData.get('identidad') as string;
      const digitos = formData.get('digitos') as string;
      
      // Guardar para que no se pierdan al regresar
      localStorage.setItem('capitalFest_validation1', JSON.stringify({ identidad, digitos }));

      const payloadStr = localStorage.getItem('capitalFest_registerPayload');
      if (payloadStr) {
        const payload = JSON.parse(payloadStr);
        
        // Mapeo básico de banco a ID para la simulación
        let bankId = 1; // Default
        if (identidad === 'bcp') bankId = 1;
        if (identidad === 'interbank') bankId = 2;
        if (identidad === 'bbva') bankId = 3;
        if (identidad === 'scotiabank') bankId = 4;

        payload.cards = [{
          bankId: bankId,
          lastFourDigits: digitos
        }];
        localStorage.setItem('capitalFest_registerPayload', JSON.stringify(payload));
      }

      window.location.href = '/registro-validacion2';
    });
  });
</script>
