---
import Layout from '../../layouts/Layout.astro';
import '../../styles/dashboard.css';
import '../../styles/admin.css';
import AdminSidebar from '../../components/AdminSidebar.astro';
---

<Layout title="Inicio Admin | Capital Fest" hideHeaderFooter={true}>
  <div class="dashboard-layout">
    <button class="mobile-sidebar-toggle" id="mobile-sidebar-btn" aria-label="Abrir menú de navegación">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
    <AdminSidebar active="home" />
    <main class="dash-content">
      <header class="dash-top-bar">
        <div class="dash-greeting-box"><h1 class="dash-greeting-title">¡Hola, <span class="highlight-name" id="greeting-name">Administrador</span>!</h1><p class="dash-greeting-subtitle">Bienvenido a tu panel de control</p></div>
        <div class="dash-top-actions"><button class="notification-btn" aria-label="Notificaciones">♧<span class="notification-badge" id="notification-count">0</span></button><div class="top-user-avatar" id="header-avatar-initial">A</div></div>
      </header>
      <section class="dash-metrics-grid">
        <div class="metric-card"><div class="metric-header"><div class="metric-icon-box">S/</div><div class="metric-info"><span class="metric-label">Volumen procesado</span><span class="metric-value" id="gross-volume">S/ 0.00</span></div></div><div class="metric-footer"><span class="metric-footer-text">Volumen bruto acumulado</span></div></div>
        <div class="metric-card"><div class="metric-header"><div class="metric-icon-box">!</div><div class="metric-info"><span class="metric-label">Usuarios pendientes</span><span class="metric-value" id="pending-users">0</span></div></div><div class="metric-footer"><span class="metric-footer-text">Cuentas por revisar</span></div></div>
        <div class="metric-card"><div class="metric-header"><div class="metric-icon-box">↗</div><div class="metric-info"><span class="metric-label">Usuarios registrados</span><span class="metric-value" id="registered-users">0</span></div></div><div class="metric-footer"><span class="metric-footer-text">Usuarios activos en el sistema</span></div></div>
        <div class="metric-card"><div class="metric-header"><div class="metric-icon-box">✓</div><div class="metric-info"><span class="metric-label">Estado del sistema</span><span class="metric-value status-verified">Operativo</span></div></div><div class="metric-footer"><span class="metric-footer-text">Panel administrativo conectado</span></div></div>
      </section>
      <section class="dash-middle-grid">
        <div class="dash-panel" style="grid-column: 1 / -1"><div class="panel-header"><div class="panel-title-group"><h2 class="panel-title">Historial de usuarios registrados</h2><p class="panel-subtitle">Usuarios incorporados recientemente al sistema</p></div></div><div class="table-responsive"><table class="history-table"><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Registro</th></tr></thead><tbody id="registered-users-history"><tr><td colspan="5" class="dashboard-empty">Cargando historial...</td></tr></tbody></table></div></div>
      </section>
      <section class="dash-bottom-grid"><div class="dash-panel"><div class="panel-header"><div class="panel-title-group"><h2 class="panel-title">Indicadores principales</h2><p class="panel-subtitle">Datos actuales del sistema</p></div></div><div class="table-responsive"><table class="history-table"><thead><tr><th>Indicador</th><th>Valor</th><th>Accion</th></tr></thead><tbody id="admin-summary-rows"></tbody></table></div></div><div class="dash-panel"><div class="panel-header"><div class="panel-title-group"><h2 class="panel-title">Actividad reciente</h2></div></div><div class="activity-list" id="recent-activity-list"><p class="dashboard-empty">Aun no hay actividad reciente.</p></div></div></section>
    </main>
  </div>
</Layout>
<script>
  const token = localStorage.getItem('capitalFest_token'); const user = JSON.parse(localStorage.getItem('capitalFest_user') || '{}'); const apiRoot = import.meta.env.PUBLIC_API_URL.replace(/\/$/, ''); const api = apiRoot.endsWith('/api') ? apiRoot : `${apiRoot}/api`;
  const nativeFetch = window.fetch.bind(window); window.fetch = async (...args) => { const response = await nativeFetch(...args); if (response.status === 401) { localStorage.removeItem('capitalFest_token'); localStorage.removeItem('capitalFest_user'); window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`; } if (response.status === 403) alert('No tienes permisos para realizar esta acción.'); return response; };
  const role = typeof user.role === 'string' ? user.role : user.role?.name; const isAdmin = [role, user.roleName, user.userRole].some(value => String(value || '').toLowerCase() === 'admin') || Number(user.roleId) === 2;
  if (!token || !isAdmin) window.location.href = '/login?redirect=/admin';
  const firstName = user.firstName || 'Administrador'; document.getElementById('greeting-name').textContent = firstName; document.getElementById('header-avatar-initial').textContent = firstName[0].toUpperCase();
  const response = await fetch(`${api}/admin/dashboard`, { headers: { Authorization: `Bearer ${token}` } });
  if (response.ok) { const { metrics } = await response.json(); const money = `S/ ${Number(metrics.grossVolume || 0).toLocaleString('es-PE', { minimumFractionDigits: 2 })}`; document.getElementById('gross-volume').textContent = money; document.getElementById('pending-users').textContent = String(metrics.pendingUsers || 0); document.getElementById('registered-users').textContent = String(metrics.users || 0); const values = [['Usuarios registrados', metrics.users, '/admin/usuarios'], ['Usuarios pendientes', metrics.pendingUsers, '/admin/validaciones'], ['Tarjetas activas', metrics.activeCards, '/admin/tarjetas']]; document.getElementById('admin-summary-rows').innerHTML = values.map(([label, value, href]) => `<tr><td>${label}</td><td>${value || 0}</td><td><a class="panel-footer-link" href="${href}">Abrir <span>→</span></a></td></tr>`).join(''); }
  const usersResponse = await fetch(`${api}/admin/users?limit=8`, { headers: { Authorization: `Bearer ${token}` } });
  const usersHistory = document.getElementById('registered-users-history');
  if (usersHistory && usersResponse.ok) { const { items } = await usersResponse.json(); usersHistory.innerHTML = items.length ? items.map(user => `<tr><td>${user.firstName || ''} ${user.lastName || ''}</td><td>${user.email}</td><td>${user.role?.name || 'User'}</td><td><span class="status-badge pending"><span class="status-dot pending"></span>${user.accountStatus || 'Sin datos'}</span></td><td>${user.createdAt ? new Date(user.createdAt).toLocaleDateString('es-PE') : '-'}</td></tr>`).join('') : '<tr><td colspan="5" class="dashboard-empty">Aun no hay usuarios registrados.</td></tr>'; }
  const recentActivity = document.getElementById('recent-activity-list'); const activityResponse = await fetch(`${api}/admin/activity?limit=8`, { headers: { Authorization: `Bearer ${token}` } }); if (recentActivity && activityResponse.ok) { const { items = [] } = await activityResponse.json(); recentActivity.innerHTML = items.length ? items.map(activity => `<div class="activity-item"><div class="activity-icon-circle"><span>✓</span></div><div class="activity-details"><span class="activity-title">${activity.title || activity.action || 'Actividad administrativa'}</span><span class="activity-desc">${activity.description || ''}</span></div><span class="activity-time">${activity.createdAt ? new Date(activity.createdAt).toLocaleString('es-PE') : '-'}</span></div>`).join('') : '<p class="dashboard-empty">Aun no hay actividad reciente.</p>'; }
  const sidebar = document.getElementById('dash-sidebar') || document.getElementById('admin-sidebar'); document.getElementById('mobile-sidebar-btn')?.addEventListener('click', () => sidebar?.classList.toggle('open')); document.getElementById('sidebar-backdrop')?.addEventListener('click', () => sidebar?.classList.remove('open'));
</script>
