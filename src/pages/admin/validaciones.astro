---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Validaciones KYC" active="validations">
  <section class="admin-section"><div class="admin-section-head"><h2>Identidades pendientes</h2><span class="admin-notice">Revisa los documentos antes de aprobar.</span></div><table class="admin-table"><thead><tr><th>Usuario</th><th>Correo</th><th>Documentos</th><th>Fecha</th><th>Accion</th></tr></thead><tbody id="validations-body"></tbody></table></section>
</AdminShell>
<script>
  const token = localStorage.getItem('capitalFest_token'); const api = import.meta.env.PUBLIC_API_URL; const body = document.getElementById('validations-body');
  const load = async () => { const response = await fetch(`${api}/admin/validations?limit=50`, { headers: { Authorization: `Bearer ${token}` } }); if (!response.ok) { body.innerHTML = '<tr><td colspan="5" class="admin-empty">No se pudieron cargar las validaciones.</td></tr>'; return; } const { items } = await response.json(); body.innerHTML = items.length ? items.map(item => `<tr><td>${item.user.firstName} ${item.user.lastName}</td><td>${item.user.email}</td><td>${[item.documentFrontUrl, item.documentBackUrl, item.selfieWithDocumentUrl].filter(Boolean).length} archivos</td><td>${new Date(item.createdAt).toLocaleDateString('es-PE')}</td><td><button class="admin-button validation-action" data-id="${item.id}" data-status="approved">Aprobar</button> <button class="admin-button validation-action" data-id="${item.id}" data-status="rejected">Rechazar</button></td></tr>`).join('') : '<tr><td colspan="5" class="admin-empty">No hay validaciones pendientes.</td></tr>'; document.querySelectorAll('.validation-action').forEach(button => button.addEventListener('click', async event => { const target = event.currentTarget; const reason = target.dataset.status === 'rejected' ? 'Documentación no válida' : undefined; const response = await fetch(`${api}/admin/validations/${target.dataset.id}`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ status: target.dataset.status, reason }) }); if (response.ok) load(); else alert('No se pudo actualizar la validación.'); })); };
  load();
</script>
