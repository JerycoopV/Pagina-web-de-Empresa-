---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Validaciones KYC" active="validations">
  <section class="admin-section"><div class="admin-section-head"><h2>Identidades pendientes</h2><span class="admin-notice">Acepta o bloquea el acceso según la documentación revisada.</span></div><table class="admin-table"><thead><tr><th>Usuario</th><th>Correo</th><th>Documentos</th><th>Fecha</th><th>Accion</th></tr></thead><tbody id="validations-body"></tbody></table></section>
</AdminShell>
<script>
  const token = localStorage.getItem('capitalFest_token'); const api = import.meta.env.PUBLIC_API_URL; const body = document.getElementById('validations-body'); const recordAdminActivity = (title, description) => { const activities = JSON.parse(localStorage.getItem('capitalFest_admin_activity') || '[]'); activities.unshift({ title, description, createdAt: new Date().toISOString() }); localStorage.setItem('capitalFest_admin_activity', JSON.stringify(activities.slice(0, 20))); };
  const load = async () => { const response = await fetch(`${api}/admin/validations?limit=50`, { headers: { Authorization: `Bearer ${token}` } }); if (!response.ok) { body.innerHTML = '<tr><td colspan="5" class="admin-empty">No se pudieron cargar las validaciones.</td></tr>'; return; } const { items } = await response.json(); body.innerHTML = items.length ? items.map(item => `<tr><td>${item.user.firstName} ${item.user.lastName}</td><td>${item.user.email}</td><td>${[item.documentFrontUrl, item.documentBackUrl, item.selfieWithDocumentUrl].filter(Boolean).length} archivos</td><td>${new Date(item.createdAt).toLocaleDateString('es-PE')}</td><td><button class="admin-button validation-action" data-id="${item.id}" data-user-id="${item.user.id}" data-status="approved" data-account-status="active" type="button">Aceptar</button> <button class="admin-button validation-action" data-id="${item.id}" data-user-id="${item.user.id}" data-status="rejected" data-account-status="blocked" type="button">Bloquear</button></td></tr>`).join('') : '<tr><td colspan="5" class="admin-empty">No hay validaciones pendientes.</td></tr>'; document.querySelectorAll('.validation-action').forEach(button => button.addEventListener('click', async event => { const target = event.currentTarget; const userName = target.closest('tr').querySelector('td').textContent.trim(); const reason = target.dataset.status === 'rejected' ? 'Documentación no válida' : undefined; const validationResponse = await fetch(`${api}/admin/validations/${target.dataset.id}`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ status: target.dataset.status, reason }) }); if (!validationResponse.ok) { alert('No se pudo actualizar la validación.'); return; } const userResponse = await fetch(`${api}/admin/users/${target.dataset.userId}/status`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ status: target.dataset.accountStatus }) }); if (userResponse.ok) { recordAdminActivity(target.dataset.accountStatus === 'active' ? 'Cuenta aceptada' : 'Cuenta bloqueada', `${target.dataset.accountStatus === 'active' ? 'Aceptaste' : 'Bloqueaste'} la cuenta de ${userName}`); load(); } else alert('La validación se actualizó, pero no se pudo actualizar el estado del usuario.'); })); };
  load();
</script>
