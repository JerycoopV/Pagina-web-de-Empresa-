---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Usuarios" active="users">
  <section class="admin-section"><div class="admin-section-head"><h2>Usuarios registrados</h2><div class="admin-actions"><input class="admin-input" id="user-search" placeholder="Buscar nombre o correo" /><select class="admin-select" id="user-role-filter"><option value="">Todos los roles</option><option value="admin">Administrador</option><option value="user">Usuario</option></select><select class="admin-select" id="user-status-filter"><option value="">Todos los estados</option><option value="active">Activo</option><option value="blocked">Bloqueado</option></select><button class="admin-button" id="user-filter" type="button">Buscar</button></div></div><table class="admin-table"><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Accion</th></tr></thead><tbody id="users-body"></tbody></table></section>
</AdminShell>
<script>
  const token = localStorage.getItem('capitalFest_token'); const api = import.meta.env.PUBLIC_API_URL; const body = document.getElementById('users-body');
  const load = async () => { const search = encodeURIComponent((document.getElementById('user-search')).value); const role = (document.getElementById('user-role-filter')).value.toLowerCase(); const status = (document.getElementById('user-status-filter')).value.toLowerCase(); const response = await fetch(`${api}/admin/users?limit=50&search=${search}`, { headers: { Authorization: `Bearer ${token}` } }); if (!response.ok) { body.innerHTML = '<tr><td colspan="5" class="admin-empty">No se pudieron cargar los usuarios.</td></tr>'; return; } const { items } = await response.json(); const filteredItems = items.filter(user => { const userRole = String(user.role?.name || user.role || 'user').toLowerCase(); const userStatus = String(user.accountStatus || '').toLowerCase(); const roleMatches = !role || userRole === role || (role === 'user' && userRole === 'usuario'); return roleMatches && (!status || userStatus === status); }); body.innerHTML = filteredItems.length ? filteredItems.map(user => `<tr><td>${user.firstName} ${user.lastName}</td><td>${user.email}</td><td>${user.role?.name || 'User'}</td><td><span class="admin-status">${user.accountStatus}</span></td><td><div class="admin-actions"><button class="admin-button user-change" data-id="${user.id}" data-status="active" type="button">Activar</button><button class="admin-button user-change" data-id="${user.id}" data-status="blocked" type="button">Bloquear</button></div></td></tr>`).join('') : '<tr><td colspan="5" class="admin-empty">No hay usuarios con esos filtros.</td></tr>'; document.querySelectorAll('.user-change').forEach(button => button.addEventListener('click', async event => { const target = event.currentTarget; const response = await fetch(`${api}/admin/users/${target.dataset.id}/status`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ status: target.dataset.status }) }); if (response.ok) load(); else alert('No se pudo actualizar el usuario.'); })); };
  document.getElementById('user-filter').addEventListener('click', load); load();
</script>
