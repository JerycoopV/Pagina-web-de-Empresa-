---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Operaciones" active="operations">
  <section class="admin-section"><div class="admin-section-head"><h2>Operaciones de usuarios</h2><div class="admin-actions"><input class="admin-input" id="operation-search" placeholder="Buscar ID o correo" /><select class="admin-select" id="operation-status"><option value="">Todos los estados</option><option>pending</option><option>reviewing</option><option>approved</option><option>completed</option><option>rejected</option><option>cancelled</option></select><button class="admin-button" id="operation-filter">Filtrar</button></div></div><table class="admin-table"><thead><tr><th>Operacion</th><th>Usuario</th><th>Monto</th><th>Fecha</th><th>Estado</th><th>Accion</th></tr></thead><tbody id="operations-body"></tbody></table></section>
</AdminShell>
<script>
  const token = localStorage.getItem('capitalFest_token'); const api = import.meta.env.PUBLIC_API_URL; const body = document.getElementById('operations-body');
  const load = async () => { const search = encodeURIComponent((document.getElementById('operation-search')).value); const status = encodeURIComponent((document.getElementById('operation-status')).value); const response = await fetch(`${api}/admin/operations?limit=50&search=${search}&status=${status}`, { headers: { Authorization: `Bearer ${token}` } }); if (!response.ok) { body.innerHTML = '<tr><td colspan="6" class="admin-empty">No se pudieron cargar las operaciones.</td></tr>'; return; } const { items } = await response.json(); body.innerHTML = items.length ? items.map(item => `<tr><td>${item.simulation.operationCode}</td><td>${item.simulation.user.email}</td><td>S/ ${Number(item.simulation.grossAmount).toLocaleString('es-PE')}</td><td>${new Date(item.createdAt).toLocaleDateString('es-PE')}</td><td><span class="admin-status">${item.status}</span></td><td><select class="admin-select operation-change" data-id="${item.simulation.operationCode}"><option value="">Cambiar</option><option value="reviewing">Revisar</option><option value="approved">Aprobar</option><option value="completed">Completar</option><option value="rejected">Rechazar</option><option value="cancelled">Cancelar</option></select></td></tr>`).join('') : '<tr><td colspan="6" class="admin-empty">No hay operaciones.</td></tr>'; document.querySelectorAll('.operation-change').forEach(select => select.addEventListener('change', async event => { const target = event.currentTarget; if (!target.value) return; const response = await fetch(`${api}/admin/operations/${target.dataset.id}/status`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ status: target.value }) }); if (response.ok) load(); else alert('No se pudo actualizar la operación.'); })); };
  document.getElementById('operation-filter').addEventListener('click', load); load();
</script>
