---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Resumen administrativo" active="dashboard">
  <section class="admin-grid" id="admin-stats"><div class="admin-stat"><label>Usuarios registrados</label><strong>0</strong></div><div class="admin-stat"><label>Operaciones</label><strong>0</strong></div><div class="admin-stat"><label>Por revisar</label><strong>0</strong></div><div class="admin-stat"><label>Volumen procesado</label><strong>S/ 0.00</strong></div></section>
  <section class="admin-section"><div class="admin-section-head"><div><h2>Centro de operaciones</h2><p class="admin-notice">Las cifras se actualizan desde la base de datos.</p></div><div class="admin-actions"><a class="admin-button" href="/admin/operaciones">Revisar operaciones</a><a class="admin-button" href="/admin/validaciones">Ver validaciones</a></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Indicador</th><th>Valor</th><th>Accion</th></tr></thead><tbody id="admin-summary-rows"></tbody></table></div></section>
</AdminShell>
<script>
  const token = localStorage.getItem('capitalFest_token');
  const api = import.meta.env.PUBLIC_API_URL;
  const response = await fetch(`${api}/admin/dashboard`, { headers: { Authorization: `Bearer ${token}` } });
  if (response.ok) {
    const { metrics } = await response.json();
    const values = [
      ['Usuarios registrados', metrics.users, '/admin/usuarios'],
      ['Usuarios pendientes', metrics.pendingUsers, '/admin/validaciones'],
      ['Operaciones pendientes', metrics.pendingOperations, '/admin/operaciones'],
      ['Tarjetas activas', metrics.activeCards, '/admin/usuarios'],
      ['Volumen bruto', `S/ ${metrics.grossVolume.toLocaleString('es-PE')}`, '/admin/operaciones'],
    ];
    document.getElementById('admin-stats').innerHTML = values.slice(0, 4).map(([label, value]) => `<div class="admin-stat"><label>${label}</label><strong>${value}</strong><small>Base de datos en tiempo real</small></div>`).join('');
    document.getElementById('admin-summary-rows').innerHTML = values.map(([label, value, href]) => `<tr><td>${label}</td><td>${value}</td><td><a class="admin-button" href="${href}">Abrir</a></td></tr>`).join('');
  }
</script>
