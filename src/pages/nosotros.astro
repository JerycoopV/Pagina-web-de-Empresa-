---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import '../styles/index.css';
import '../styles/nosotros.css';
---

<Layout title="Nosotros | Capital Fest">
  <div class="nosotros-page-container">
    <div class="nosotros-grid">
      <!-- Columna Izquierda: Título, Textos e Imagen -->
      <div class="nosotros-content">
        <div class="nosotros-title-container animate-on-load">
          <h1 class="nosotros-title">Nosotros</h1>
        </div>
        
        <p class="nosotros-desc animate-on-load delay-1">
          Capital Fest es una solución financiera <br class="desktop-br" />
          que te permite acceder a efectivo desde <br class="desktop-br" />
          tu tarjeta de crédito de forma rápida, <br class="desktop-br" />
          simple y segura cuando lo necesitas.
        </p>
        
        <p class="nosotros-desc animate-on-load delay-2">
          Nuestro objetivo es facilitar el acceso a <br class="desktop-br" />
          tu dinero sin complicaciones, ofreciendo <br class="desktop-br" />
          una alternativa práctica para resolver <br class="desktop-br" />
          necesidades inmediatas.
        </p>
        
        <div class="nosotros-image-container animate-on-load delay-3">
          <img src="/assets/tarjeta-nosotro3.webp" alt="Capital Fest - Tarjeta en pedestal con monedas flotantes" class="nosotros-image" />
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta Glassmorphic de Información -->
      <div class="nosotros-glass-card animate-on-load delay-4">
        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">¿Por qué elegirnos?</h2>
          <p class="nosotros-info-text">
            Brindamos una atención personalizada basada en la transparencia, la confianza y la rapidez, acompañándote en cada etapa del proceso con responsabilidad, seguridad y el compromiso de ofrecerte una experiencia financiera clara, eficiente y confiable.
          </p>
        </div>

        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">Misión</h2>
          <p class="nosotros-info-text">
            Transformamos tu línea de crédito en efectivo inmediato mediante una experiencia rápida, simple y segura, diseñada para brindarte total confianza,
          </p>
        </div>

        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">Visión</h2>
          <p class="nosotros-info-text">
            Transformamos tu línea de crédito en efectivo inmediato mediante una experiencia rápida, simple y segura, diseñada para brindarte total confianza,
          </p>
        </div>

        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">Horario</h2>
          <ul class="nosotros-schedule-list">
            <li>Lunes a sábado: 8:00am a 6:00pm</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Sección Bancos Afiliados -->
    <div class="nosotros-bancos-section animate-on-scroll">
      <h2 class="nosotros-bancos-title">Bancos <span class="text-gradient nosotros-bancos-title-span">Afiliados</span></h2>
      <div class="nosotros-bancos-card">
        <div class="bancos-grid-row row-1">
          <img src="/assets/banco4.webp" alt="Scotiabank" class="nosotros-banco-logo" style="height: 68px; max-width: 260px;" />
          <img src="/assets/banco1.webp" alt="BanBif" class="nosotros-banco-logo" />
          <img src="/assets/banco5.webp" alt="Interbank" class="nosotros-banco-logo" style="height: 68px; max-width: 260px;" />
        </div>
        <div class="bancos-grid-row row-2">
          <img src="/assets/banco2.webp" alt="BBVA" class="nosotros-banco-logo" />
          <img src="/assets/banco3.webp" alt="BCP" class="nosotros-banco-logo" />
        </div>
      </div>
    </div>

    <!-- Sección: Banner de Llamado a la Acción (CTA) -->
    <section class="cta-banner-section animate-on-scroll" id="cta-banner" style="margin-top: 80px;">
      <div class="cta-card">
        <span class="badge">RÁPIDO, SEGURO Y CONFIABLE</span>
        
        <h2 class="cta-title">
          Obtén efectivo en <span class="text-gradient">minutos.</span>
        </h2>
        
        <p class="cta-description">
          Convierte el saldo de tu tarjeta de crédito al instante, de forma segura y sin problemas.
        </p>

        <div class="cta-actions">
          <a href="/simulador" class="btn btn-hero-gradient" id="cta-btn-simular">
            Simular retiro
          </a>
          <a href="/#como-funciona" class="btn-cta-outline" id="cta-btn-como-funciona">
            Cómo funciona
          </a>
        </div>

        <div class="cta-footer-text">
          100% Seguro • Sin complicaciones • Respuesta inmediata
        </div>
      </div>
    </section>
  </div>

  <!-- Script de Intersección para Animaciones de Scroll Premium -->
  <script>
    // Configuración del Observador de Intersección
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -80px 0px', // Activa la animación un poco antes de que entre del todo en pantalla
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target); // Solo animar una vez al entrar
        }
      });
    }, observerOptions);

    // Observar todos los elementos designados para animarse al deslizar
    const scrollElements = document.querySelectorAll('.animate-on-scroll');
    scrollElements.forEach(el => observer.observe(el));
  </script>
</Layout>
