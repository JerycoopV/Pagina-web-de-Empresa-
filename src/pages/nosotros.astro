---
import Layout from '../layouts/Layout.astro';
import '../styles/nosotros.css';
---

<Layout title="Nosotros | Capital Fest">
  <div class="nosotros-page-container">
    <div class="nosotros-grid">
      <!-- Columna Izquierda: Título, Textos e Imagen -->
      <div class="nosotros-content">
        <div class="nosotros-title-container">
          <h1 class="nosotros-title">Nosotros</h1>
        </div>
        
        <p class="nosotros-desc">
          Capital Fest es una solución financiera <br class="desktop-br" />
          que te permite acceder a efectivo desde <br class="desktop-br" />
          tu tarjeta de crédito de forma rápida, <br class="desktop-br" />
          simple y segura cuando lo necesitas.
        </p>
        
        <p class="nosotros-desc">
          Nuestro objetivo es facilitar el acceso a <br class="desktop-br" />
          tu dinero sin complicaciones, ofreciendo <br class="desktop-br" />
          una alternativa práctica para resolver <br class="desktop-br" />
          necesidades inmediatas.
        </p>
        
        <div class="nosotros-image-container">
          <img src="/assets/tarjeta-nosotro3.webp" alt="Capital Fest - Tarjeta en pedestal con monedas flotantes" class="nosotros-image" />
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta Glassmorphic de Información -->
      <div class="nosotros-glass-card">
        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">¿Por qué elegirnos?</h2>
          <p class="nosotros-info-text">
            Brindamos una atención personalizada basada en la transparencia, la confianza y la rapidez, acompañándote en cada etapa del proceso con responsabilidad, seguridad y el compromiso de ofrecerte una experiencia financiera clara, eficiente y confiable.
          </p>
        </div>

        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">Misión</h2>
          <p class="nosotros-info-text">
            Transformamos tu línea de crédito en efectivo inmediato mediante una experiencia rápida, simple y segura, diseñada para brindarte total confianza,
          </p>
        </div>

        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">Visión</h2>
          <p class="nosotros-info-text">
            Transformamos tu línea de crédito en efectivo inmediato mediante una experiencia rápida, simple y segura, diseñada para brindarte total confianza,
          </p>
        </div>

        <div class="nosotros-info-item">
          <h2 class="nosotros-info-title">Horario</h2>
          <ul class="nosotros-schedule-list">
            <li>Lunes a sábado: 8:00am a 6:00pm</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Sección Bancos Afiliados -->
    <div class="nosotros-bancos-section">
      <h2 class="nosotros-bancos-title">Bancos <span class="text-gradient nosotros-bancos-title-span">Afiliados</span></h2>
      <div class="nosotros-bancos-card">
        <div class="bancos-grid-row row-1">
          <img src="/assets/banco3.webp" alt="Scotiabank" class="nosotros-banco-logo" />
          <img src="/assets/banco4.webp" alt="BanBif" class="nosotros-banco-logo" />
          <img src="/assets/banco2.webp" alt="Interbank" class="nosotros-banco-logo" />
        </div>
        <div class="bancos-grid-row row-2">
          <img src="/assets/banco1.webp" alt="BBVA" class="nosotros-banco-logo" />
          <img src="/assets/banco5.webp" alt="BCP" class="nosotros-banco-logo" />
        </div>
      </div>
    </div>
  </div>
</Layout>
