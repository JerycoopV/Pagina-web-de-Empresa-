---
import Layout from '../layouts/Layout.astro';
import '../styles/registro-validacion.css';
---

<Layout title="Activación de Cuenta | Capital Fest">
  <section class="register-section">
    <div class="register-container">
      <div class="register-grid">
        
        <!-- Columna Izquierda: Información de marca y Tarjeta 3D -->
        <div class="register-info-side">
          <h1 class="register-title animate-on-load">
            Tu dinero,<br />
            cuando más lo<br />
            <span class="text-gradient">necesites.</span>
          </h1>
          <p class="register-description animate-on-load delay-1">
            Convierte el saldo de tu tarjeta de crédito en efectivo al instante, de forma segura y sin vueltas.
          </p>

          <!-- Composición Visual -->
          <div class="register-visual animate-on-load delay-2">
            <img src="/assets/TARJETA-INICIO-SESION.webp" alt="Tarjeta Capital Fest Activación" class="register-visual-img" />
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Activación -->
        <div class="register-form-side">
          <div class="register-card animate-on-load delay-3" style="display: flex; flex-direction: column; justify-content: center; padding: 64px 48px;">
            
            <!-- Encabezado de la Tarjeta -->
            <div class="register-card-header" style="justify-content: center; margin-bottom: 40px;">
              <h2 style="text-align: center; font-size: 32px;">Activación de cuenta</h2>
            </div>

            <!-- Mensaje de Activación -->
            <div class="activation-message" style="margin-bottom: 48px;">
              <p style="font-size: 16px; color: rgba(255, 255, 255, 0.85); line-height: 1.6; margin-bottom: 20px;">
                Estás muy cerca de completar tu solicitud. Para finalizar el proceso y validar tus datos de manera segura, por favor <span style="color: #ea580c; font-weight: 600;">comunícate</span> con nosotros a través de nuestro número oficial <span style="color: #ea580c; font-weight: 600;">+51 902 029 862</span>.
              </p>
              <p style="font-size: 16px; color: rgba(255, 255, 255, 0.85); line-height: 1.6;">
                Uno de nuestros asesores te atenderá de inmediato.
              </p>
            </div>

            <!-- Botón de WhatsApp -->
            <div class="btn-group-vertical" style="margin-top: 0; gap: 15px;">
              <a id="whatsapp-link" href="https://wa.me/51902029862" target="_blank" rel="noopener noreferrer" class="btn-submit" style="text-decoration: none;">
                Ir a WhatsApp
              </a>
              <button type="button" class="btn-submit" id="btn-finalizar" style="background: transparent; border: 1px solid rgba(255,255,255,0.3); box-shadow: none;">
                Ir a login
              </button>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    
    // Obtener datos del usuario
    const userNameStr = localStorage.getItem('capitalFest_userName');
    let fullName = '';
    if (userNameStr) {
      try {
        const userName = JSON.parse(userNameStr);
        fullName = `${userName.firstName || ''} ${userName.lastName || ''}`.trim();
      } catch (e) {}
    }
    
    // Configurar enlace de WhatsApp
    const whatsappNumber = '51902029862';
    const message = fullName 
      ? `Soy ${fullName} y me acabo de registrar en Capital Fest, me gustaría continuar con la activación de mi cuenta.` 
      : `Hola. Me acabo de registrar en Capital Fest y me gustaría continuar con la activación de mi cuenta.`;
    
    const whatsappLink = document.getElementById('whatsapp-link') as HTMLAnchorElement;
    if (whatsappLink) {
      whatsappLink.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
    }

    if (urlParams.get('success') === '1') {
      alert('¡Usuario se registró correctamente!');
      
      // Limpiar la URL para que no vuelva a saltar la alerta si el usuario recarga la página
      // pero manteniendo otros parámetros
      urlParams.delete('success');
      const newQuery = urlParams.toString();
      const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + (newQuery ? '?' + newQuery : '');
      window.history.replaceState({path:newUrl}, '', newUrl);
    }

    const btnFinalizar = document.getElementById('btn-finalizar');
    if (btnFinalizar) {
      btnFinalizar.addEventListener('click', () => {
        const redirect = urlParams.get('redirect');
        const monto = urlParams.get('monto');
        if (redirect) {
          let redirectUrl = redirect;
          if (monto) {
            redirectUrl += `?monto=${monto}`;
          }
          window.location.href = redirectUrl;
        } else {
          window.location.href = '/login';
        }
      });
    }
  });
</script>
